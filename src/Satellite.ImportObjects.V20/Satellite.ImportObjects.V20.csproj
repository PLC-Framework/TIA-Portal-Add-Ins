<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <!-- x64, unlike the satellites that never touch TIA: this process loads TIA Portal's own
         64-bit Openness assemblies into itself. -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Satellite.ImportObjects</RootNamespace>
    <AssemblyName>PLC-Framework.Satellite.ImportObjects.V20</AssemblyName>
    <ApplicationIcon>..\..\assets\Brand\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Satellite.ImportObjects\Satellite.ImportObjects.csproj" />
    <ProjectReference Include="..\Openness.V20\Openness.V20.csproj" />
  </ItemGroup>

</Project>
