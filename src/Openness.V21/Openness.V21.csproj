<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- The half of the Openness client that touches Siemens, for TIA Portal V21: attaching,
       finding a PLC, a unit and a folder, and importing into it. Every satellite that talks to
       TIA from outside it uses this through its own V21 executable.

       x64 for the reason the executables are: the process this is loaded into loads TIA's own
       64-bit assemblies. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Openness</RootNamespace>
    <AssemblyName>PLC-Framework.Openness.V21</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <SiemensPublicApi Condition="'$(SiemensPublicApi)' == ''">$(MSBuildThisFileDirectory)..\..\..\.lib\Siemens\PublicAPI</SiemensPublicApi>
    <TiaApi>$(SiemensPublicApi)\V21\net48</TiaApi>
  </PropertyGroup>

  <!-- An Openness *client*: the object model and none of the AddIn assemblies. Never copied:
       the executable finds TIA's own at run time, since they are not redistributable. -->
  <ItemGroup>
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaApi)\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- V21 splits the object model: PlcSoftware, the blocks, the types and the tag tables
         live here, while V20 carries them all inside its one client assembly. -->
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(TiaApi)\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Openness.Shared\Openness.Shared.csproj" />
  </ItemGroup>

</Project>
