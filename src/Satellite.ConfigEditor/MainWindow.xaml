<Window x:Class="Satellite.ConfigEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Config editor"
        Icon="{StaticResource BrandLogo}"
        Height="700" Width="920"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkThemeGradientBrush}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="OnClosing">

    <Window.Resources>
        <!-- Section navigation. Local to this window: it is the only one with sections, and
             UI.Shared takes what a second consumer actually needs, not what one might. -->
        <Style TargetType="ListBoxItem" x:Key="NavItem">
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" />
                                <!-- The dot says this section has problems. Per concern,
                                     which is exactly how the validator reports them. -->
                                <Ellipse x:Name="Dot" Width="6" Height="6" Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource BrandBrushTop}"
                                         Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrushTop}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasIssues}" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionTitle">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionNote">
            <Setter Property="Foreground" Value="#7E8899" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style TargetType="TextBlock" x:Key="GroupTitle">
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>

        <!-- The cross inside a tag. Borderless and transparent, so the tag reads as one
             object rather than as a label sitting next to a button. -->
        <Style TargetType="Button" x:Key="ChipClose">
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushTop}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub-navigation inside a section. RadioButtons rather than a TabControl: the
             panels they switch between live in the layout above, and a TabControl would
             bring its own chrome to fight with the dark theme for no gain. -->
        <Style TargetType="RadioButton" x:Key="Tab">
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrushTop}" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One rule a type or an interface section implements, as a tag with a cross. Shared
             by both lists, so a dangling reference looks and is removed the same way in each. -->
        <DataTemplate x:Key="RuleChip">
            <Border x:Name="Chip" Margin="0,0,6,5"
                    Padding="7,2,3,2" CornerRadius="3"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource FieldEdge}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <!-- TextBlock, not Content: WPF reads _ as an accelerator and hides it,
                         and an id is an exact key. -->
                    <TextBlock x:Name="Label" Text="{Binding Id}"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Ink}" />
                    <Button Content="✕" Width="18" Padding="0"
                            Margin="5,0,0,0"
                            Style="{StaticResource ChipClose}"
                            ToolTip="Stop implementing this rule"
                            Tag="{Binding}" Click="OnRemoveRuleFromType" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- No rule of that name exists: a reference left dangling by a hand-edited
                     file. Shown so it can be removed, not hidden. -->
                <DataTrigger Binding="{Binding IsKnown}" Value="False">
                    <Setter TargetName="Chip" Property="BorderBrush"
                            Value="{StaticResource BrandBrushTop}" />
                    <Setter TargetName="Label" Property="Foreground"
                            Value="{StaticResource BrandBrushTop}" />
                    <Setter TargetName="Chip" Property="ToolTip"
                            Value="No rule with this id. Remove it, or add a rule that name." />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,18,20,14">
            <Image Source="{StaticResource BrandLogo}" Width="34" Height="34" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Config editor" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource BrandBrushTop}" />
                <TextBlock x:Name="ProjectLine" FontSize="11" Foreground="#7E8899" />
            </StackPanel>
        </StackPanel>

        <!-- Body: navigation on the left, the chosen section on the right -->
        <Grid Grid.Row="1" x:Name="Body" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="NavPanel" Width="170" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource FieldEdge}" BorderThickness="1">
                <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="OnSectionChanged" />
            </Border>

            <Border Grid.Column="1" Margin="14,0,0,0" Padding="18"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource FieldEdge}" BorderThickness="1">
                <!-- No ScrollViewer around all of this, deliberately. One here would hand
                     every panel infinite height, so a * row inside behaves like Auto: the
                     rule list would grow without end and push its own buttons off screen.
                     Each panel brings the scrolling it actually needs instead. -->
                <Grid>
                        <!-- ===================== Metadata ===================== -->
                        <ScrollViewer x:Name="MetadataPanel" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Metadata" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionNote}"
                                       Text="Where the core comes from, and who wrote this configuration." />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Core source" Style="{StaticResource FieldLabel}" />
                                <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="CoreSourceBox"
                                           HorizontalAlignment="Left" Width="200"
                                           SelectionChanged="OnCoreSourceChanged" />

                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Foreground="#7E8899"
                                           Text="Which repository section the Add-In reads. None means no repository - only actions that read a core need one - and is written as null. A section not in use is kept but never validated." />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Version" Style="{StaticResource FieldLabel}" Margin="0,14,10,0" />
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="VersionBox" Margin="0,14,0,0"
                                           HorizontalAlignment="Left" Width="200" TextChanged="OnFieldChanged" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Author" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="AuthorBox" Margin="0,10,0,0"
                                           TextChanged="OnFieldChanged" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Description" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="DescriptionBox" Margin="0,10,0,0"
                                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                           VerticalScrollBarVisibility="Auto"
                                           VerticalContentAlignment="Top" TextChanged="OnFieldChanged" />
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>

                        <!-- ===================== Repository ===================== -->
                        <ScrollViewer x:Name="RepositoryPanel" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Repository" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionNote}"
                                       Text="Where the core library is fetched from. Both sections are kept in the file; the dimmed one is simply not in use." />

                            <!-- Local -->
                            <TextBlock x:Name="LocalTitle" Text="Local" Style="{StaticResource GroupTitle}" Margin="0,0,0,8" />
                            <Grid x:Name="LocalGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Repository" Style="{StaticResource FieldLabel}" />
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="LocalRepositoryBox" TextChanged="OnFieldChanged" />
                                <Button    Grid.Row="0" Grid.Column="2" Content="..." Width="34" Margin="8,0,0,0"
                                           Padding="0,4" Style="{StaticResource Quiet}" Click="OnBrowseLocalRepository" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="LocalFolderBox" Margin="0,10,0,0" TextChanged="OnFieldChanged" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Dependency file" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="LocalDependencyBox" Margin="0,10,0,0" TextChanged="OnFieldChanged" />
                            </Grid>

                            <!-- Remote -->
                            <TextBlock x:Name="RemoteTitle" Text="Remote" Style="{StaticResource GroupTitle}" />
                            <Grid x:Name="RemoteGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="API URL" Style="{StaticResource FieldLabel}" />
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ApiUrlBox" TextChanged="OnFieldChanged" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Owner" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="OwnerBox" Margin="0,10,0,0" TextChanged="OnFieldChanged" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Repository" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="RemoteRepositoryBox" Margin="0,10,0,0" TextChanged="OnFieldChanged" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Branch" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="BranchBox" Margin="0,10,0,0"
                                           HorizontalAlignment="Left" Width="200" TextChanged="OnFieldChanged" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Folder" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="RemoteFolderBox" Margin="0,10,0,0" TextChanged="OnFieldChanged" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Dependency file" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="RemoteDependencyBox" Margin="0,10,0,0" TextChanged="OnFieldChanged" />

                                <!-- The token, and it never enters config.json: the file
                                     always carries the literal ${GITHUB_TOKEN} and the
                                     secret goes to the per-user .env. -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Token" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                <Grid      Grid.Row="6" Grid.Column="1" Margin="0,10,0,0">
                                    <PasswordBox x:Name="TokenBox" Padding="6,4,26,4"
                                                 PasswordChanged="OnTokenChanged" />
                                    <TextBox     x:Name="TokenPlain" Padding="6,4,26,4" Visibility="Collapsed"
                                                 TextChanged="OnTokenChanged" />
                                    <ToggleButton x:Name="TokenReveal" Style="{StaticResource Reveal}"
                                                  HorizontalAlignment="Right" Margin="0,1,2,1"
                                                  ToolTip="Show or hide the token"
                                                  Checked="OnTokenRevealChanged" Unchecked="OnTokenRevealChanged" />
                                </Grid>

                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="TokenNote" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Foreground="#7E8899" />
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>

                        <!-- ===================== Coding style ===================== -->
                        <Grid x:Name="CodingStylePanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Coding style" Style="{StaticResource SectionTitle}" />

                            <!-- Two catalogues, one area: the tab decides which the list shows,
                                 because a rule's id, pattern and description are the same whichever
                                 catalogue it lives in. -->
                            <Grid Grid.Row="1" Margin="0,6,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ObjectRulesTab" Content="Object rules" IsChecked="True"
                                                 Style="{StaticResource Tab}" Checked="OnCodingTab" />
                                    <RadioButton x:Name="InterfaceRulesTab" Content="Interface rules"
                                                 Style="{StaticResource Tab}" Checked="OnCodingTab" />
                                    <RadioButton x:Name="AppliesTab" Content="Applies to"
                                                 Style="{StaticResource Tab}" Checked="OnCodingTab" />
                                </StackPanel>

                                <!-- One line, trimmed, the whole sentence in the tooltip: wrapped,
                                     it ran to four lines at the window's minimum width and took
                                     the height the rule detail needs. -->
                                <TextBlock Grid.Column="1" x:Name="CatalogueHint" Margin="16,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           Foreground="{StaticResource InkMuted}" />
                            </Grid>

                            <!-- Rules: the catalogue on the left, one rule on the right -->
                            <Grid Grid.Row="2" x:Name="RulesArea">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- The list scrolls inside itself, so the buttons below it
                                     stay put however many rules there are. -->
                                <Border Grid.Row="0" Grid.Column="0"
                                        Background="{StaticResource Field}"
                                        BorderBrush="{StaticResource FieldEdge}" BorderThickness="1">
                                    <ListBox x:Name="RuleList" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource Ink}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="OnRuleSelected" />
                                </Border>

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="AddRuleButton" Content="+" Width="32" Padding="0,4"
                                            FontSize="15" Style="{StaticResource Quiet}"
                                            ToolTip="Add a rule" Click="OnAddRule" />
                                    <Button x:Name="RemoveRuleButton" Content="✕" Width="32" Padding="0,4"
                                            Margin="8,0,0,0" Style="{StaticResource Destructive}"
                                            ToolTip="Remove the selected rule, and every reference to it"
                                            Click="OnRemoveRule" />
                                </StackPanel>

                                <!-- The interface and the description share what height is left,
                                     each scrolling inside itself. Both star rows rather than one
                                     sized to its content: the interface of a function runs to six
                                     sections, and an Auto row would push the description out of
                                     the window. An interface rule has no interface, so its row is
                                     set to nothing in code.

                                     At the window's minimum size the detail does not fit at all,
                                     so it scrolls - but the grid takes the viewport's height, with
                                     a floor, rather than the infinite height a ScrollViewer hands
                                     its content. That is what keeps the star rows sharing space
                                     at any size; a plain ScrollViewer would turn them into Auto,
                                     the trap the section's own note records. -->
                                <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" x:Name="RuleDetailScroll"
                                              Margin="16,0,0,0" Focusable="False"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid x:Name="RuleDetail" MinHeight="400"
                                      Height="{Binding ViewportHeight, ElementName=RuleDetailScroll}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="InterfaceRow" Height="3*" MinHeight="70" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="2*" MinHeight="60" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" Style="{StaticResource FieldLabel}" />
                                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="RuleIdBox"
                                                   LostFocus="OnRuleIdCommitted" KeyDown="OnRuleIdKey" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Pattern" Style="{StaticResource FieldLabel}" Margin="0,10,10,0" />
                                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="RuleRegexBox" Margin="0,10,0,0"
                                                   FontFamily="Consolas" TextChanged="OnRuleRegexChanged" />

                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RegexState" Margin="0,5,0,0"
                                                   TextWrapping="Wrap" />

                                        <!-- A pattern that compiles can still be perfectly
                                             wrong. This is the only way to find that out
                                             before the Add-In marks half a project. -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Try it" Style="{StaticResource FieldLabel}" Margin="0,12,10,0" />
                                        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="RuleSampleBox" Margin="0,12,0,0"
                                                   FontFamily="Consolas" TextChanged="OnRuleSampleChanged" />

                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SampleState" Margin="0,5,0,0"
                                                   TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- Interface: object rules only. Which interface rules the
                                         names inside an object this rule names answer to, per
                                         section. The rows are the same shape as Applies to - a
                                         type from a closed set, and the rules it implements. -->
                                    <Grid Grid.Row="1" x:Name="InterfaceHeader">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Interface" Style="{StaticResource GroupTitle}" />

                                        <!-- Columns, not overlapping layers: at the minimum width
                                             the note ran into the title. It gives way instead. -->
                                        <TextBlock Grid.Column="1" Margin="12,0,10,8" VerticalAlignment="Bottom"
                                                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource InkMuted}"
                                                   Text="a section not listed is not checked"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                                        <Button Grid.Column="2" x:Name="AddSectionButton" Content="Add section" Width="100"
                                                Padding="0,3" Margin="0,0,0,6" VerticalAlignment="Bottom"
                                                Style="{StaticResource Quiet}"
                                                ToolTipService.ShowOnDisabled="True"
                                                Click="OnAddSection" />
                                    </Grid>

                                    <Border Grid.Row="2" x:Name="InterfaceArea"
                                            Background="{StaticResource Field}"
                                            BorderBrush="{StaticResource FieldEdge}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock x:Name="InterfaceEmpty" Margin="10,8" TextWrapping="Wrap"
                                                       Foreground="{StaticResource InkMuted}"
                                                       Text="No sections, so nothing inside the objects this rule names is checked." />

                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="InterfaceList" Margin="6,6,6,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- The drop-down and the tags share one
                                                                     wrap panel: side by side when they fit,
                                                                     the tags on the next line when they do
                                                                     not. In columns of their own, the tags
                                                                     were cut to "varia" at the window's
                                                                     minimum width. -->
                                                                <WrapPanel Grid.Column="0">
                                                                    <!-- The eight sections, spelled as TIA
                                                                         spells them; the free ones plus this
                                                                         row's own, so no two rows match. -->
                                                                    <ComboBox Width="120" VerticalAlignment="Top"
                                                                              ItemsSource="{Binding AvailableTypes}"
                                                                              SelectedItem="{Binding Type, Mode=TwoWay}" />

                                                                    <ItemsControl Margin="10,3,0,0"
                                                                                  ItemsSource="{Binding Implemented}"
                                                                                  ItemTemplate="{StaticResource RuleChip}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                    </ItemsControl>
                                                                </WrapPanel>

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            Margin="8,0,0,0" VerticalAlignment="Top">
                                                                    <Button Content="+" Width="26" Padding="0,2"
                                                                            Style="{StaticResource Quiet}"
                                                                            IsEnabled="{Binding CanAddRule}"
                                                                            ToolTip="Answer to another interface rule"
                                                                            Tag="{Binding}" Click="OnAddRuleToType" />
                                                                    <Button Content="✕" Width="26" Padding="0,2"
                                                                            Margin="6,0,0,0"
                                                                            Style="{StaticResource Destructive}"
                                                                            ToolTip="Remove this section: its names stop being checked"
                                                                            Tag="{Binding}" Click="OnRemoveSection" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <!-- The hint sits beside the heading rather than under
                                         the box. Below it, it competed with the box for the
                                         last of the height and won, leaving a two-line
                                         field with the note overlapping it. -->
                                    <Grid Grid.Row="3">
                                        <TextBlock Text="Description" Style="{StaticResource GroupTitle}" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   Margin="0,0,0,8" Foreground="#7E8899"
                                                   Text="one line each, optional" />
                                    </Grid>

                                    <!-- Takes whatever height is left and scrolls inside
                                         it: some of these rules run to nine lines, and
                                         letting the box grow would push everything else
                                         out of the window. -->
                                    <TextBox Grid.Row="4" x:Name="RuleDescriptionBox" MinHeight="60"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             TextChanged="OnRuleDescriptionChanged" />
                                </Grid>
                                </ScrollViewer>
                            </Grid>

                            <!-- Applies to: the five lists, one after another. This one does
                                 need scrolling of its own - ten rows of tags do not fit. -->
                            <ScrollViewer Grid.Row="2" x:Name="AppliesArea" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AppliesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,20">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource GroupTitle}" Margin="0,0,0,6" />

                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource Field}"
                                                                BorderBrush="{StaticResource FieldEdge}" BorderThickness="1"
                                                                Padding="8,6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="180" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Closed set: a type outside it
                                                                     cannot match a real TIA object,
                                                                     so it is chosen, never typed.
                                                                     The list holds the free types
                                                                     plus this row's own, so no two
                                                                     rows can end up the same. -->
                                                                <ComboBox Grid.Column="0" VerticalAlignment="Top"
                                                                          ItemsSource="{Binding AvailableTypes}"
                                                                          SelectedItem="{Binding Type, Mode=TwoWay}" />

                                                                <!-- Only what this type implements, as
                                                                     tags. A box per rule would be a
                                                                     hundred and fifty controls across a
                                                                     section, nearly all of them empty. -->
                                                                <ItemsControl Grid.Column="1" Margin="12,2,0,0"
                                                                              ItemsSource="{Binding Implemented}"
                                                                              ItemTemplate="{StaticResource RuleChip}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                            VerticalAlignment="Top">
                                                                    <Button Content="+" Width="26" Padding="0,2"
                                                                            Style="{StaticResource Quiet}"
                                                                            IsEnabled="{Binding CanAddRule}"
                                                                            ToolTip="Implement another rule"
                                                                            Tag="{Binding}" Click="OnAddRuleToType" />
                                                                    <Button Content="✕" Width="26" Padding="0,2"
                                                                            Margin="6,0,0,0"
                                                                            Style="{StaticResource Destructive}"
                                                                            ToolTip="Remove this type"
                                                                            Tag="{Binding}" Click="OnRemoveType" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Disabled once every type of the closed set has a
                                                 row: there is nothing left that could be added
                                                 without duplicating a pairing that already exists. -->
                                            <Button Content="Add type" Width="100" Padding="0,5"
                                                    HorizontalAlignment="Left" Style="{StaticResource Quiet}"
                                                    IsEnabled="{Binding CanAdd}"
                                                    ToolTip="Add one of the types this section still has free"
                                                    Tag="{Binding}" Click="OnAddType" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- ===================== Hierarchy ===================== -->
                        <Grid x:Name="HierarchyPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Hierarchy" Style="{StaticResource SectionTitle}" />

                            <!-- Four concerns plus the optional software units. One TreeView
                                 below serves all seven trees: the tab decides which array it
                                 is bound to. -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <RadioButton x:Name="BlocksTab" Content="Blocks" IsChecked="True"
                                             Style="{StaticResource Tab}" Checked="OnConcernChanged" />
                                <RadioButton x:Name="TechnologyTab" Content="Technology objects"
                                             Style="{StaticResource Tab}" Checked="OnConcernChanged" />
                                <RadioButton x:Name="TagTablesTab" Content="Tag tables"
                                             Style="{StaticResource Tab}" Checked="OnConcernChanged" />
                                <RadioButton x:Name="TypesTab" Content="Types"
                                             Style="{StaticResource Tab}" Checked="OnConcernChanged" />
                                <RadioButton x:Name="UnitsTab" Content="Software units"
                                             Style="{StaticResource Tab}" Checked="OnConcernChanged" />
                            </StackPanel>

                            <!-- Only while Software units is selected: its own three lists,
                                 and the switch that creates or removes the whole section. -->
                            <Grid Grid.Row="2" x:Name="UnitsBar" Visibility="Collapsed" Margin="0,8,0,0">
                                <StackPanel x:Name="UnitsTabs" Orientation="Horizontal">
                                    <RadioButton x:Name="UnitBlocksTab" Content="Blocks" IsChecked="True"
                                                 Style="{StaticResource Tab}" Checked="OnUnitConcernChanged" />
                                    <RadioButton x:Name="UnitTagTablesTab" Content="Tag tables"
                                                 Style="{StaticResource Tab}" Checked="OnUnitConcernChanged" />
                                    <RadioButton x:Name="UnitTypesTab" Content="Types"
                                                 Style="{StaticResource Tab}" Checked="OnUnitConcernChanged" />
                                </StackPanel>

                                <Button x:Name="UnitsToggle" HorizontalAlignment="Right" Width="150" Padding="0,5"
                                        Style="{StaticResource Quiet}" Click="OnToggleUnits" />
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Scrolls inside itself so the buttons below stay put,
                                     however deep the tree goes. -->
                                <Border Grid.Row="0" Grid.Column="0"
                                        Background="{StaticResource Field}"
                                        BorderBrush="{StaticResource FieldEdge}" BorderThickness="1">
                                    <TreeView x:Name="GroupsTree" Background="Transparent" BorderThickness="0"
                                              Foreground="{StaticResource Ink}"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              SelectedItemChanged="OnGroupSelected">
                                        <!-- BasedOn the implicit style from Controls.xaml,
                                             which carries the template; only the binding to
                                             the model's own expanded state is local. -->
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem"
                                                   BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <!-- TextBlock, not a string: a folder called
                                                     0-Containers is fine, but one with an
                                                     underscore would lose it to accelerator
                                                     parsing. -->
                                                <TextBlock x:Name="Label" Text="{Binding Name}"
                                                           Foreground="{StaticResource Ink}" />
                                                <HierarchicalDataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDuplicate}" Value="True">
                                                        <Setter TargetName="Label" Property="Foreground"
                                                                Value="{StaticResource BrandBrushTop}" />
                                                        <Setter TargetName="Label" Property="ToolTip"
                                                                Value="Another folder beside this one has the same name." />
                                                    </DataTrigger>
                                                </HierarchicalDataTemplate.Triggers>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </Border>

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="AddRootButton" Content="+ Folder" Width="90" Padding="0,5"
                                            Style="{StaticResource Quiet}"
                                            ToolTip="Add a folder at the top of this list"
                                            Click="OnAddRootGroup" />
                                    <Button x:Name="AddChildButton" Content="+ Sub-folder" Width="110" Padding="0,5"
                                            Margin="8,0,0,0" Style="{StaticResource Quiet}"
                                            ToolTip="Add a folder inside the selected one"
                                            Click="OnAddChildGroup" />
                                    <Button x:Name="RemoveGroupButton" Content="✕" Width="32" Padding="0,5"
                                            Margin="8,0,0,0" Style="{StaticResource Destructive}"
                                            ToolTip="Remove the selected folder and everything inside it"
                                            Click="OnRemoveGroup" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                            x:Name="GroupDetail" Margin="16,0,0,0">
                                    <TextBlock Text="Folder" Style="{StaticResource SectionTitle}" FontSize="13" />
                                    <TextBlock Style="{StaticResource SectionNote}" Margin="0,0,0,10"
                                               Text="The name TIA Portal gives the group." />

                                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"
                                               HorizontalAlignment="Left" Margin="0,0,0,4" />
                                    <TextBox x:Name="GroupNameBox" TextChanged="OnGroupNameChanged" />

                                    <TextBlock x:Name="GroupWarning" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource BrandBrushTop}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ============== Not editable here yet ============== -->
                        <StackPanel x:Name="LaterPanel" Visibility="Collapsed">
                            <TextBlock x:Name="LaterTitle" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionNote}"
                                       Text="This section is not editable in this window yet — edit it by hand for now." />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkMuted}"
                                       Text="Saving from here leaves it exactly as it is. Every key in the file survives a save, including ones this editor knows nothing about, because it edits the JSON tree in place rather than rewriting it from a model." />
                        </StackPanel>

                        <!-- ============== No configuration yet ============== -->
                        <StackPanel x:Name="MissingPanel" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="MissingText" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{StaticResource Ink}" FontSize="14" />
                            <TextBlock x:Name="MissingPath" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="#7E8899" Margin="0,8,0,0" />
                            <Button x:Name="CreateButton" Content="Create from template" Width="200" Padding="0,8"
                                    Margin="0,20,0,0" HorizontalAlignment="Center"
                                    Style="{StaticResource Primary}" Click="OnCreateFromTemplate" />
                            <Button x:Name="ChooseButton" Content="Choose a project folder..." Width="200" Padding="0,7"
                                    Margin="0,10,0,0" HorizontalAlignment="Center"
                                    Style="{StaticResource Quiet}" Click="OnChooseProject" />
                        </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="20,14,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusLine" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{StaticResource Ink}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RevertButton" Content="Revert" Width="110" Padding="0,7"
                        Margin="0,0,10,0" Style="{StaticResource Quiet}" Click="OnRevert" />
                <Button x:Name="SaveButton" Content="Save" Width="130" Padding="0,7"
                        Style="{StaticResource Primary}" Click="OnSave" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
