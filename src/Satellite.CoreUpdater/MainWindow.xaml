<Window x:Class="Satellite.CoreUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UI.Shared.Controls;assembly=PLC-Framework.UI.Shared"
        Title="Core updater"
        Height="640" Width="1000"
        MinHeight="420" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        Icon="{StaticResource BrandLogo}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The badge carries V20 or V21: this window is built once per TIA version and is
             otherwise identical in both, so which one is running is not something the
             operator could tell from looking. -->
        <ui:BrandHeader x:Name="Header" Grid.Row="0" Title="Core updater" />

        <!-- One panel at a time: waiting, the project, or the reason neither. Toggled with
             Visibility from the code-behind rather than by binding - this window has a
             handful of transitions in its whole life, and a view model for them would be
             ceremony around a few assignments. -->
        <Grid Grid.Row="1" Margin="0,18,0,0">

            <StackPanel x:Name="WaitingPanel" VerticalAlignment="Center">
                <TextBlock x:Name="WaitingText"
                           Text="Looking for the TIA Portal that opened this…"
                           FontSize="14" Foreground="{StaticResource Ink}"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Height="4" Width="260" Margin="0,14,0,0" />
            </StackPanel>

            <Grid x:Name="AttachedPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The PLC and the unit sit on one row, sharing their label column through
                     SharedSizeGroup rather than a Width: a constant lines two rows up at
                     exactly one window size, and this one resizes. -->
                <Grid Grid.Row="0" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="PlcBox" Grid.Row="0" Grid.Column="1" Height="26"
                              SelectionChanged="PlcChanged" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Software unit" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,10,10,0" />
                    <ComboBox x:Name="UnitBox" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,10,0,0"
                              SelectionChanged="UnitChanged" />

                    <!-- Compare reads the map back off disk rather than using whatever is in
                         memory, so it works on a window reopened tomorrow and so the round
                         trip through repo\project.json is the one that gets exercised. -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button x:Name="CompareButton" Content="Compare with core"
                                Style="{StaticResource Quiet}" Padding="16,4"
                                IsEnabled="False" Click="CompareClicked" />

                        <!-- The only button in this framework that changes somebody's project.
                             It stays off until something is ticked, and what it would touch is
                             worked out and shown before a single source is written. -->
                        <Button x:Name="DownloadButton" Content="Download" Margin="8,0,0,0"
                                Style="{StaticResource Primary}" Padding="16,4"
                                IsEnabled="False" Click="DownloadClicked" />
                    </StackPanel>

                    <Button x:Name="MapButton" Grid.Row="1" Grid.Column="2" Content="Map project"
                            Style="{StaticResource Primary}" Margin="10,10,0,0" Padding="16,4"
                            Click="MapClicked" />
                </Grid>

                <!-- What to map: one row per kind of object, and on that row the languages
                     found inside *that* kind. Both columns are built from the counts the
                     survey took out of this very PLC, never from a list in the code - the
                     language enum has twenty-nine values and a project uses four or five, so a
                     fixed list would be mostly empty boxes. The day a GRAPH block arrives it
                     appears on the row it belongs to, with its count, and nothing here changes.

                     The rows are added from the code-behind, because how many there are and
                     what is on each is a property of the project rather than of this file.
                     Row 0 is the two headings and stays. -->
                <Grid x:Name="FilterPanel" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,18,0">
                        <TextBlock Text="Objects" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <Button Content="All" Style="{StaticResource Quiet}" Padding="8,1" Margin="10,0,0,0"
                                Click="AllKinds" />
                        <Button Content="None" Style="{StaticResource Quiet}" Padding="8,1" Margin="4,0,0,0"
                                Click="NoKinds" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Languages" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                        <Button Content="All" Style="{StaticResource Quiet}" Padding="8,1" Margin="10,0,0,0"
                                Click="AllLanguages" />
                        <Button Content="None" Style="{StaticResource Quiet}" Padding="8,1" Margin="4,0,0,0"
                                Click="NoLanguages" />
                    </StackPanel>
                </Grid>

                <!-- One area, two things in it: what a walk had to say, or the comparison. They
                     are never both true at once, and stacking them would leave a map's counts
                     on screen under a comparison of a different scope. -->
                <ScrollViewer x:Name="ResultPanel" Grid.Row="2" Margin="0,18,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="MapHeading" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{StaticResource InkGood}" Visibility="Collapsed" />
                        <TextBlock x:Name="MapText" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource InkMuted}" />
                        <TextBlock x:Name="MapProblems" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource InkWarn}" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>

                <!-- The project on the left, the repository on the right (the maintainer's
                     layout). The splitter between them is what lets one side be read in full
                     without the window growing: a block's folder is long and a core node's name
                     is not. -->
                <Grid x:Name="ComparePanel" Grid.Row="2" Margin="0,18,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" MinWidth="300" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" MinWidth="230" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock x:Name="ProjectHeading" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />

                        <!-- The counts are the filters, as in the coding-style report. They are
                             tick boxes rather than chips because this window already has two
                             rows of them and one vocabulary is worth more than one more control. -->
                        <WrapPanel x:Name="ChipsPanel" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock x:Name="RepositoryHeading" Style="{StaticResource FieldLabel}"
                                   TextWrapping="Wrap" />

                        <!-- The same idea as the left, by state rather than by finding: with
                             both trees open this is how "show me what is missing" is asked, and
                             it is the first thing importing will want. -->
                        <WrapPanel x:Name="RepoChipsPanel" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- A tree on both sides, so the two panels read alike. The project's comes
                         out of the map's own folder paths, which already start with TIA's name
                         for the tree - `Program blocks`, `PLC data types` - under one root for
                         the scope the map covers. -->
                    <TreeView x:Name="ProjectTree" Grid.Row="1" Grid.Column="0" Margin="0,8,12,0" />

                    <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="3"
                                  HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                  Background="{StaticResource FieldEdge}" />

                    <TreeView x:Name="RepositoryTree" Grid.Row="1" Grid.Column="2" Margin="12,8,0,0" />

                    <TextBlock x:Name="CompareProblems" Grid.Row="2" Grid.ColumnSpan="3"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource InkWarn}" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <!-- Scrolled, because the failure that matters most is the longest: when the
                 Openness assemblies cannot be found, this carries the account of every
                 registry key that was read and every folder that was probed. The first
                 version centred it in a fixed row and clipped it on the VM, cutting off
                 the half that said where it had looked. -->
            <ScrollViewer x:Name="ProblemPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="ProblemText" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource InkBad}" />
                    <TextBlock x:Name="ConsideredText" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource InkMuted}" />

                    <!-- When it could not tell which TIA Portal this belongs to, the same list
                         it would otherwise have printed becomes the choice. Nothing is
                         preselected: a highlighted row invites the click that this panel
                         exists to stop being automatic. -->
                    <ListBox x:Name="ChoicesList" Visibility="Collapsed"
                             Margin="0,12,0,0" MaxHeight="150"
                             SelectionChanged="ChoiceChanged" />
                    <Button x:Name="AttachButton" Content="Attach" Visibility="Collapsed"
                            Style="{StaticResource Primary}" IsEnabled="False"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,4"
                            Click="AttachClicked" />
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,16,0,0"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource InkMuted}" />
    </Grid>
</Window>
