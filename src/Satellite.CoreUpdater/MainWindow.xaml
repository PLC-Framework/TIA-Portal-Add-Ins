<Window x:Class="Satellite.CoreUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Core updater"
        Height="360" Width="640"
        MinHeight="300" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        Icon="{StaticResource BrandLogo}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Image Source="{StaticResource BrandLogo}" Width="28" Height="28" VerticalAlignment="Center" />
            <TextBlock Text="Core updater" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Ink}" />
        </StackPanel>

        <!-- One panel at a time: waiting, attached, or the reason neither. Toggled with
             Visibility from the code-behind rather than by binding, because there is one
             transition in this window's whole life and a view model for it would be
             ceremony around a single assignment. -->
        <Grid Grid.Row="1" Margin="0,18,0,0">

            <StackPanel x:Name="WaitingPanel" VerticalAlignment="Center">
                <TextBlock x:Name="WaitingText"
                           Text="Looking for the TIA Portal that opened this…"
                           FontSize="14" Foreground="{StaticResource Ink}"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Height="4" Width="260" Margin="0,14,0,0" />
            </StackPanel>

            <StackPanel x:Name="AttachedPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="Attached to TIA Portal" FontSize="14"
                           Foreground="{StaticResource InkGood}" />

                <TextBlock Text="Project" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                <TextBlock x:Name="ProjectNameText" FontSize="14" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Ink}" />

                <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                <TextBlock x:Name="ProjectFolderText" TextWrapping="Wrap"
                           Foreground="{StaticResource InkMuted}" />

                <TextBlock x:Name="ProcessText" Margin="0,12,0,0"
                           Foreground="{StaticResource InkMuted}" />
            </StackPanel>

            <StackPanel x:Name="ProblemPanel" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="ProblemText" FontSize="14" TextWrapping="Wrap"
                           Foreground="{StaticResource InkBad}" />
                <TextBlock x:Name="ConsideredText" Margin="0,14,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource InkMuted}" />
            </StackPanel>

        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,16,0,0"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource InkMuted}" />
    </Grid>
</Window>
