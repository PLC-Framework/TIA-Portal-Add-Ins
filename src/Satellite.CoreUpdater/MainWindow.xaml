<Window x:Class="Satellite.CoreUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UI.Shared.Controls;assembly=PLC-Framework.UI.Shared"
        Title="Core updater"
        Height="860" Width="1180"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen">

    <!-- Merged on the window rather than on an application, because this project has none:
         no `App.xaml` is what lets one library serve the V20 and V21 executables, and an
         `ApplicationDefinition` would generate a `Main` that has to live in one assembly.

         `UI.Shared/Controls/BrandHeader.xaml` already does exactly this for the same reason,
         so the pattern is the repository's rather than a new one. The URI carries the
         **assembly** name, and `Controls.xaml` pulls `Theme.xaml` in itself.

         It is also what makes the XAML designer work. Visual Studio builds the design-time
         `Application.Resources` out of `App.xaml`; with none, every `{StaticResource}` in this
         file came back as XDG-0001 and the designer rendered nothing - forty errors against a
         window that compiled and ran perfectly well, because WPF resolves these at load time
         rather than at compile time. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PLC-Framework.UI.Shared;component/Resources/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PLC-Framework.UI.Shared;component/Resources/BrandLogo.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Property elements, below `Window.Resources`, and not attributes on the start tag:
         an attribute is set as the parser reads that tag, before it has reached the
         dictionary declared underneath, so `Background="{StaticResource …}"` up there cannot
         see what is down here. Every other use in this file is on a child element, where the
         lookup walks up to the window and finds it. -->
    <Window.Background>
        <StaticResource ResourceKey="DarkThemeGradientBrush" />
    </Window.Background>
    <Window.Icon>
        <StaticResource ResourceKey="BrandLogo" />
    </Window.Icon>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The badge carries V20 or V21: this window is built once per TIA version and is
             otherwise identical in both, so which one is running is not something the
             operator could tell from looking. -->
        <ui:BrandHeader x:Name="Header" Grid.Row="0" Title="Core updater" />

        <!-- One panel at a time: waiting, the project, or the reason neither. Toggled with
             Visibility from the code-behind rather than by binding - this window has a
             handful of transitions in its whole life, and a view model for them would be
             ceremony around a few assignments. -->
        <Grid Grid.Row="1" Margin="0,18,0,0">

            <StackPanel x:Name="WaitingPanel" VerticalAlignment="Center">
                <TextBlock x:Name="WaitingText"
                           Text="Looking for the TIA Portal that opened this…"
                           FontSize="14" Foreground="{StaticResource Ink}"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Height="4" Width="260" Margin="0,14,0,0" />
            </StackPanel>

            <Grid x:Name="AttachedPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The PLC and the unit on one line (the maintainer's layout): they are one
                     decision - which software this window is about - and two rows made it read
                     as two. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="PLC" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="PlcBox" Grid.Column="1" Height="26"
                              SelectionChanged="PlcChanged" />

                    <TextBlock Grid.Column="2" Text="Software unit" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="18,0,10,0" />
                    <ComboBox x:Name="UnitBox" Grid.Column="3" Height="26"
                              SelectionChanged="UnitChanged" />
                </Grid>

                <!-- The project on the left, the repository on the right (the maintainer's
                     layout, settled before any of this was built), and **a middle column that
                     is the actions rather than a divider** (2026-09-18, laid out by the
                     maintainer "por acciones y dominios").

                     Each side owns what belongs to it alone: its filter, its tree, its caption.
                     What sits between them is what *crosses* between them - importing the core
                     into the project, and putting the project's own blocks back where the core
                     says they go - so the arrow on Download & Import says which way, and
                     neither belongs under either tree. `Reload` is one button because it brings
                     both halves up to date at once; two of them was the same work twice under
                     different names. -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="300" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ============================ the project ============================ -->

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                Margin="0,0,16,8">
                        <TextBlock Text="Project tree" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" />

                        <!-- What to map and what to show are both decisions taken once per run,
                             and as three columns of tick boxes they were taking a third of the
                             window for the rest of it. -->
                        <Button x:Name="ProjectFilterButton" Content="Filter" Margin="12,0,0,0"
                                Style="{StaticResource Primary}" Padding="12,2"
                                Click="ProjectFilterClicked"
                                PreviewMouseLeftButtonDown="FilterPressed" />
                    </StackPanel>

                    <!-- A visible edge on each container (asked for): with two trees side by
                         side and both scrolling, where one ends and the other begins is
                         otherwise only the gap between them. -->
                    <Border Grid.Row="1" Grid.Column="0" Margin="0,0,16,0"
                            BorderBrush="{StaticResource FieldEdge}" BorderThickness="1" Padding="6">
                        <TreeView x:Name="ProjectTree" />
                    </Border>

                    <TextBlock x:Name="ProjectStatus" Grid.Row="2" Grid.Column="0"
                               Margin="0,10,16,0" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource InkMuted}" />

                    <!-- ============================ the actions ============================ -->

                    <!-- Between the two panels because that is what they act across, and only
                         in the tree's own row: the captions below belong to a tree each. -->
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Center">
                            <!-- Moving blocks inside somebody's project, so it says what it
                                 would move and waits to be told before it moves anything. -->
                            <Button x:Name="SyncButton" Content="Sync folders with core"
                                    Style="{StaticResource Quiet}" Padding="12,4" MinWidth="152"
                                    IsEnabled="False" Click="SyncClicked" />

                            <!-- The arrow is the direction: out of the core, into the project.
                                 It stays off until something is ticked, and what it would touch
                                 is worked out and shown before a single source is written. -->
                            <Button x:Name="DownloadButton" Content="&lt;&lt; Download &amp; Import"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource Primary}" Padding="12,4" MinWidth="152"
                                    IsEnabled="False" Click="DownloadClicked" />
                        </StackPanel>

                        <!-- One button for both halves: it walks the project again, brings the
                             core's copy up to date and compares the two. Splitting it in two
                             was tried on paper and dropped as the same work under two names -
                             a comparison is only worth anything with both sides current. -->
                        <Button x:Name="ReloadButton" Grid.Row="1" Content="Reload"
                                Style="{StaticResource Primary}" Padding="12,4" MinWidth="152"
                                Click="ReloadClicked" />
                    </Grid>

                    <!-- ========================== the repository =========================== -->

                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                Margin="16,0,0,8">
                        <TextBlock Text="Core tree" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" />

                        <Button x:Name="RepoFilterButton" Content="Filter" Margin="12,0,0,0"
                                Style="{StaticResource Primary}" Padding="12,2"
                                Click="RepoFilterClicked"
                                PreviewMouseLeftButtonDown="FilterPressed" />
                    </StackPanel>

                    <Border Grid.Row="1" Grid.Column="2" Margin="16,0,0,0"
                            BorderBrush="{StaticResource FieldEdge}" BorderThickness="1" Padding="6">
                        <TreeView x:Name="RepositoryTree" />
                    </Border>

                    <TextBlock x:Name="RepositoryStatus" Grid.Row="2" Grid.Column="2"
                               Margin="16,10,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource InkMuted}" />
                </Grid>

                <!-- Whatever a run had to say that will not fit on one caption: a folder that
                     would not read, an object that would not export. Never left out - a map
                     with holes that does not say where they are is the one thing a comparison
                     must not be handed. -->
                <TextBlock x:Name="ProblemsText" Grid.Row="2" Margin="0,12,0,0"
                           TextWrapping="Wrap" MaxHeight="72"
                           Foreground="{StaticResource InkWarn}" Visibility="Collapsed" />

                <!-- ===================== what the two Filter buttons open ==================== -->

                <!-- StaysOpen=False closes it on any click outside, which is what a popup like
                     this should do; the button's own PreviewMouseLeftButtonDown is what stops
                     that outside-click closing it only for the Click to reopen it. -->
                <Popup x:Name="ProjectFilterPopup" PlacementTarget="{Binding ElementName=ProjectFilterButton}"
                       Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{StaticResource Surface}" BorderThickness="1"
                            BorderBrush="{StaticResource FieldEdge}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- What to map: one row per kind of object, and on that row the
                                 languages found inside *that* kind. Both columns are built from
                                 the counts the survey took out of this very PLC, never from a
                                 list in the code - the language enum has twenty-nine values and
                                 a project uses four or five, so a fixed list would be mostly
                                 empty boxes. The day a GRAPH block arrives it appears on the row
                                 it belongs to, with its count, and nothing here changes.

                                 The rows are added from the code-behind, because how many there
                                 are and what is on each is a property of the project rather than
                                 of this file. Row 0 is the two headings and stays. -->
                            <Grid x:Name="FilterPanel" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                                            Margin="0,0,18,0">
                                    <TextBlock Text="Objects" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" />
                                    <Button Content="All" Style="{StaticResource Quiet}" Padding="8,1"
                                            Margin="10,0,0,0" Click="AllKinds" />
                                    <Button Content="None" Style="{StaticResource Quiet}" Padding="8,1"
                                            Margin="4,0,0,0" Click="NoKinds" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Languages" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" />
                                    <Button Content="All" Style="{StaticResource Quiet}" Padding="8,1"
                                            Margin="10,0,0,0" Click="AllLanguages" />
                                    <Button Content="None" Style="{StaticResource Quiet}" Padding="8,1"
                                            Margin="4,0,0,0" Click="NoLanguages" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Column="1" Width="1" Margin="18,0"
                                    Background="{StaticResource FieldEdge}" />

                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Project" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" />
                                    <Button Content="All" Style="{StaticResource Quiet}" Padding="8,1"
                                            Margin="10,0,0,0" Click="AllFindings" />
                                    <Button Content="None" Style="{StaticResource Quiet}" Padding="8,1"
                                            Margin="4,0,0,0" Click="NoFindings" />
                                </StackPanel>

                                <!-- The counts are the filters, as in the coding-style report.
                                     Tick boxes rather than chips because this popup already has
                                     two columns of them, and one vocabulary in one place is
                                     worth more than one more kind of control. -->
                                <StackPanel x:Name="ChipsPanel" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>

                <Popup x:Name="RepoFilterPopup" PlacementTarget="{Binding ElementName=RepoFilterButton}"
                       Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{StaticResource Surface}" BorderThickness="1"
                            BorderBrush="{StaticResource FieldEdge}" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Core" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" />
                                <Button Content="All" Style="{StaticResource Quiet}" Padding="8,1"
                                        Margin="10,0,0,0" Click="AllStates" />
                                <Button Content="None" Style="{StaticResource Quiet}" Padding="8,1"
                                        Margin="4,0,0,0" Click="NoStates" />
                            </StackPanel>

                            <!-- The same idea as the left, by state rather than by finding: with
                                 both trees open this is how "show me what is missing" is asked. -->
                            <StackPanel x:Name="RepoChipsPanel" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Scrolled, because the failure that matters most is the longest: when the
                 Openness assemblies cannot be found, this carries the account of every
                 registry key that was read and every folder that was probed. The first
                 version centred it in a fixed row and clipped it on the VM, cutting off
                 the half that said where it had looked. -->
            <ScrollViewer x:Name="ProblemPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="ProblemText" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource InkBad}" />
                    <TextBlock x:Name="ConsideredText" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource InkMuted}" />

                    <!-- When it could not tell which TIA Portal this belongs to, the same list
                         it would otherwise have printed becomes the choice. Nothing is
                         preselected: a highlighted row invites the click that this panel
                         exists to stop being automatic. -->
                    <ListBox x:Name="ChoicesList" Visibility="Collapsed"
                             Margin="0,12,0,0" MaxHeight="150"
                             SelectionChanged="ChoiceChanged" />
                    <Button x:Name="AttachButton" Content="Attach" Visibility="Collapsed"
                            Style="{StaticResource Primary}" IsEnabled="False"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,4"
                            Click="AttachClicked" />
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,16,0,0"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource InkMuted}" />
    </Grid>
</Window>
