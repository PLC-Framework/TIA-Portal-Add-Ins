<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Core</RootNamespace>
    <AssemblyName>PLC-Framework.Core</AssemblyName>
  </PropertyGroup>

  <!-- References. All framework assemblies TIA Portal's own process already holds: Core is
       loaded inside it, so nothing here may bring a package with it. Compression reads the
       core's .xlsx enumerations, which Openness refuses to import. -->
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
