<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AddIn.Shared</RootNamespace>
    <AssemblyName>PLC-Framework.AddIn.Shared</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <!-- For writing the satellite handoff. The framework's own serializer, so no JSON
       package is ever loaded inside TIA Portal's process. -->
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <!-- Assets live once in the repo-level assets\ folder, grouped by feature, and are
       embedded here because Assets.cs resolves them against its own assembly: embedded
       resources are scoped to the assembly that carries them, so the loader and the
       assets cannot be separated.

       A glob rather than a list, so adding an asset is just dropping a file. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\**\*.*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>