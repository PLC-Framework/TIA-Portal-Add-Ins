<Window x:Class="Satellite.DataBlockSnapshot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UI.Shared.Controls;assembly=PLC-Framework.UI.Shared"
        Title="Data block snapshot"
        Icon="{StaticResource BrandLogo}"
        Height="640" Width="780"
        MinHeight="540" MinWidth="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkThemeGradientBrush}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">


    <!-- IsSharedSizeScope is what lets the "Block" and "Folder" rows below agree on the
         width of their label column and of their button column, so both text boxes start
         and end at exactly the same place. Done with a fixed Width instead, the two line up
         at one window size and drift apart at every other - this window is resizable from
         660 upwards, and a star column grows where a constant does not. -->
    <Grid Margin="20" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <!-- The subtitle says which project and which CPU this capture belongs to. Worth
             keeping: several of these windows can be open at once, one per PLC. -->
        <ui:BrandHeader x:Name="Header" Grid.Row="0" Title="Data Block snapshot" Margin="0,0,0,18" />

        <!-- Connection.

             Same arrangement as before - the PLC on its own row, then user, password and
             timeout side by side - but placed by columns rather than by pixel margins.
             The designer writes absolute margins, which hold at exactly one window width:
             this one is resizable down to 660, and the star column grows while a fixed
             margin does not, so the fields end up overlapping. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />   <!-- PLC / User label -->
                <ColumnDefinition Width="*" />      <!-- address, user     -->
                <ColumnDefinition Width="Auto" />   <!-- Password label    -->
                <ColumnDefinition Width="*" />      <!-- password          -->
                <ColumnDefinition Width="Auto" />   <!-- Remember          -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC" Style="{StaticResource FieldLabel}" />
            <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                       x:Name="AddressBox" IsEditable="True" Margin="0,0,0,9" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="User" Style="{StaticResource FieldLabel}" />
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="UserBox" Margin="0,0,16,0" />

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Password" Style="{StaticResource FieldLabel}" />

            <!-- Two controls in one cell, one of them always hidden.
                 A PasswordBox cannot reveal what it holds and its Password is not even a
                 dependency property, so a twin TextBox is the only way; the eye swaps which
                 one is visible and carries the text across. Both reserve room on the right
                 for the eye, which floats over the field rather than sitting beside it. -->
            <Grid Grid.Row="1" Grid.Column="3" Margin="0,0,16,0">
                <PasswordBox x:Name="PasswordBox" Padding="6,4,26,4" />
                <TextBox     x:Name="PasswordPlain" Padding="6,4,26,4" Visibility="Collapsed" />

                <ToggleButton x:Name="RevealButton" Style="{StaticResource Reveal}"
                              HorizontalAlignment="Right" Margin="0,1,2,1"
                              ToolTip="Show or hide the password"
                              Checked="OnRevealChanged" Unchecked="OnRevealChanged" />
            </Grid>

            <!-- Beside the password, because that is what it is about. Ticking it only
                 states an intention: nothing is stored until the CPU has actually
                 accepted the credentials, so a typo is never remembered. -->
            <CheckBox Grid.Row="1" Grid.Column="4" x:Name="RememberBox"
                      VerticalAlignment="Center"
                      Content="Remember"
                      Foreground="{StaticResource InkMuted}"
                      ToolTip="Remember this user and password for this PLC. Kept for this Windows user only, in %LOCALAPPDATA%\PLC-Framework, and saved only after a successful login." />

            <!-- Its own row, right-aligned: the timeout is a setting one touches once, not
                 part of the credentials, and giving it a fixed column of its own was what
                 squeezed the two fields that matter. -->
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                <TextBlock Text="Timeout (s)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TimeoutBox" Text="30" Width="70" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="Data blocks" Margin="0,20,0,6"
                   Foreground="{StaticResource InkMuted}" FontWeight="SemiBold" />

        <!-- The list takes the height that is going, and its Add/Remove row stays put below
             it - the same shape as the rule list in the config editor, and for the same
             reason: controls that scroll away with their list are controls you cannot
             reach when the list is long. -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource FieldEdge}" BorderThickness="1"
                    Background="{StaticResource Surface}">
                <ListView x:Name="BlockList" BorderThickness="0" Background="Transparent"
                          Foreground="{StaticResource Ink}"
                          SelectionChanged="OnBlockSelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="30">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Block" Width="200" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="State" Width="110" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="Detail" Width="380" DisplayMemberBinding="{Binding Detail}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Typing the name is the whole point: started by hand, with no Add-In to hand
                 blocks over, this is the only way to fill the list. Enter adds too, so a
                 handful of names can be typed without reaching for the mouse. -->
            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RowLabel" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="RowActions" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Block" Style="{StaticResource FieldLabel}" />
                <TextBox   Grid.Column="1" x:Name="NewBlockBox"
                           ToolTip="Name of a data block on this CPU, then + or Enter"
                           KeyDown="OnNewBlockKeyDown" />

                <!-- Right-aligned inside the shared column: it is as wide as the Folder row's
                     pair of buttons, so these two sit flush with those rather than floating
                     in the middle of it. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AddBlockButton" Content="+" Width="32" Padding="0,4"
                            FontSize="15" Margin="8,0,0,0" Style="{StaticResource Quiet}"
                            ToolTip="Add this data block to the list" Click="OnAddBlock" />
                    <Button x:Name="RemoveBlockButton" Content="✕" Width="32" Padding="0,4"
                            Margin="8,0,0,0" Style="{StaticResource Destructive}"
                            IsEnabled="False"
                            ToolTip="Remove the selected data block from the list"
                            Click="OnRemoveBlock" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Destination -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="RowLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="RowActions" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Folder" Style="{StaticResource FieldLabel}" />
            <TextBox   Grid.Column="1" x:Name="FolderBox" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BrowseButton" Content="..." Width="34"
                        Margin="8,0,0,0" Padding="0,4" Style="{StaticResource Quiet}"
                        Click="OnBrowseFolder" />
                <!-- Stays enabled during a capture: it only looks, and watching the files
                     appear is exactly when an operator wants it. -->
                <Button x:Name="OpenFolderButton" Content="Open" Width="70"
                        Margin="8,0,0,0" Padding="0,4" Style="{StaticResource Quiet}"
                        ToolTip="Open the destination folder in Explorer"
                        Click="OnOpenFolder" />
            </StackPanel>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="130" Padding="0,7"
                    Margin="0,0,10,0" IsEnabled="False"
                    Style="{StaticResource Quiet}" Click="OnCancel" />
            <Button x:Name="CaptureButton" Content="Capture" Width="130" Padding="0,7"
                    Style="{StaticResource Primary}" Click="OnCapture" />
        </StackPanel>

        <TextBlock Grid.Row="6" x:Name="StatusLine" Margin="0,14,0,0"
                   TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
    </Grid>
</Window>
