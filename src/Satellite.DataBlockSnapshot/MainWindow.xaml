<Window x:Class="Satellite.DataBlockSnapshot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data block snapshot"
        Icon="{StaticResource BrandLogo}"
        Height="640" Width="780"
        MinHeight="540" MinWidth="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkThemeGradientBrush}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- One surface for everything the operator types into, a shade lighter than the
             ground so a field reads as inset rather than as a hole punched in the form. -->
        <SolidColorBrush x:Key="Field"       Color="#333B47" />
        <SolidColorBrush x:Key="FieldEdge"   Color="#5A6473" />
        <SolidColorBrush x:Key="Surface"     Color="#2A313B" />
        <SolidColorBrush x:Key="SurfaceHead" Color="#3A4350" />
        <SolidColorBrush x:Key="Ink"         Color="#E8ECF2" />
        <SolidColorBrush x:Key="InkMuted"    Color="#98A3B2" />

        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="SelectionBrush" Value="{StaticResource BrandBrushTop}" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushBottom}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An editable ComboBox needs its own template. The stock chrome paints the text
             area and the drop-down button from its own brushes and ignores Background,
             which is exactly what leaves a white box sitting on a dark form. -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />

                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0" Margin="5,0,0,0"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     SelectionBrush="{StaticResource BrandBrushTop}"
                                     VerticalContentAlignment="Center" />

                            <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{StaticResource InkMuted}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource FieldEdge}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceHead}" />
            <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#39424F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F4A5A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat, so the stock grey gradient does not reappear in the middle of a dark form. -->
        <Style TargetType="Button" x:Key="Quiet">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E4756" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6C7686" />
                                <Setter TargetName="Bd" Property="Background" Value="#2B323C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#454E5B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Quiet}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource BrandBrushTop}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandBrushBottom}" />
        </Style>

        <!-- The eye that reveals the password. Drawn rather than loaded: it is two paths
             and an ellipse, and an .ico would have to be embedded, resolved and themed,
             which is a great deal of machinery for sixteen pixels. Transparent background
             so it reads as part of the field it floats over, and the stroke follows the
             same brushes as everything else, so it stays right in either mood. -->
        <Style TargetType="ToggleButton" x:Key="Reveal">
            <Setter Property="Width" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent">
                            <Canvas Width="16" Height="14"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="Eye"
                                      Data="M 1,7 C 4,2.5 12,2.5 15,7 C 12,11.5 4,11.5 1,7 Z"
                                      Stroke="{StaticResource InkMuted}" StrokeThickness="1.2" />
                                <Ellipse x:Name="Pupil" Canvas.Left="6" Canvas.Top="5"
                                         Width="4" Height="4" Fill="{StaticResource InkMuted}" />
                                <!-- The strike-through, shown only while the password is
                                     on screen: the icon states what is true now, not what
                                     clicking would do. -->
                                <Path x:Name="Strike" Data="M 2,12.5 L 14,1.5"
                                      Stroke="{StaticResource InkMuted}" StrokeThickness="1.2"
                                      Visibility="Collapsed" />
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Strike" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Eye" Property="Stroke" Value="{StaticResource Ink}" />
                                <Setter TargetName="Pupil" Property="Fill" Value="{StaticResource Ink}" />
                                <Setter TargetName="Strike" Property="Stroke" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Eye" Property="Stroke" Value="#6C7686" />
                                <Setter TargetName="Pupil" Property="Fill" Value="#6C7686" />
                                <Setter TargetName="Strike" Property="Stroke" Value="#6C7686" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ToolTip" Value="Hide the password" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Image Source="{StaticResource BrandLogo}" Width="38" Height="38"
                   VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Data Block snapshot" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource BrandBrushTop}" />
                <!-- Which project and which CPU this capture belongs to. Worth keeping:
                     several of these windows can be open at once, one per PLC. -->
                <TextBlock x:Name="ProjectLine" FontSize="11" Foreground="#7E8899" />
            </StackPanel>
        </StackPanel>

        <!-- Connection.

             Same arrangement as before - the PLC on its own row, then user, password and
             timeout side by side - but placed by columns rather than by pixel margins.
             The designer writes absolute margins, which hold at exactly one window width:
             this one is resizable down to 660, and the star column grows while a fixed
             margin does not, so the fields end up overlapping. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />   <!-- PLC / User label -->
                <ColumnDefinition Width="*" />      <!-- address, user     -->
                <ColumnDefinition Width="Auto" />   <!-- Password label    -->
                <ColumnDefinition Width="*" />      <!-- password          -->
                <ColumnDefinition Width="Auto" />   <!-- Remember          -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC" Style="{StaticResource FieldLabel}" />
            <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                       x:Name="AddressBox" IsEditable="True" Margin="0,0,0,9" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="User" Style="{StaticResource FieldLabel}" />
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="UserBox" Margin="0,0,16,0" />

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Password" Style="{StaticResource FieldLabel}" />

            <!-- Two controls in one cell, one of them always hidden.
                 A PasswordBox cannot reveal what it holds and its Password is not even a
                 dependency property, so a twin TextBox is the only way; the eye swaps which
                 one is visible and carries the text across. Both reserve room on the right
                 for the eye, which floats over the field rather than sitting beside it. -->
            <Grid Grid.Row="1" Grid.Column="3" Margin="0,0,16,0">
                <PasswordBox x:Name="PasswordBox" Padding="6,4,26,4" />
                <TextBox     x:Name="PasswordPlain" Padding="6,4,26,4" Visibility="Collapsed" />

                <ToggleButton x:Name="RevealButton" Style="{StaticResource Reveal}"
                              HorizontalAlignment="Right" Margin="0,1,2,1"
                              ToolTip="Show the password"
                              Checked="OnRevealChanged" Unchecked="OnRevealChanged" />
            </Grid>

            <!-- Beside the password, because that is what it is about. Ticking it only
                 states an intention: nothing is stored until the CPU has actually
                 accepted the credentials, so a typo is never remembered. -->
            <CheckBox Grid.Row="1" Grid.Column="4" x:Name="RememberBox"
                      VerticalAlignment="Center"
                      Content="Remember"
                      Foreground="{StaticResource InkMuted}"
                      ToolTip="Remember this user and password for this PLC. Kept for this Windows user only, in %LOCALAPPDATA%\PLC-Framework, and saved only after a successful login." />

            <!-- Its own row, right-aligned: the timeout is a setting one touches once, not
                 part of the credentials, and giving it a fixed column of its own was what
                 squeezed the two fields that matter. -->
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                <TextBlock Text="Timeout (s)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="TimeoutBox" Text="30" Width="70" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="Data blocks" Margin="0,20,0,6"
                   Foreground="{StaticResource InkMuted}" FontWeight="SemiBold" />

        <Border Grid.Row="3" BorderBrush="{StaticResource FieldEdge}" BorderThickness="1"
                Background="{StaticResource Surface}">
            <ListView x:Name="BlockList" BorderThickness="0" Background="Transparent"
                      Foreground="{StaticResource Ink}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="30">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Block" Width="200" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="State" Width="110" DisplayMemberBinding="{Binding Status}" />
                        <GridViewColumn Header="Detail" Width="380" DisplayMemberBinding="{Binding Detail}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Destination -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Folder" Style="{StaticResource FieldLabel}" />
            <TextBox   Grid.Column="1" x:Name="FolderBox" />
            <Button    Grid.Column="2" x:Name="BrowseButton" Content="..." Width="34"
                       Margin="8,0,0,0" Padding="0,4" Style="{StaticResource Quiet}"
                       Click="OnBrowseFolder" />
            <!-- Stays enabled during a capture: it only looks, and watching the files
                 appear is exactly when an operator wants it. -->
            <Button    Grid.Column="3" x:Name="OpenFolderButton" Content="Open" Width="70"
                       Margin="8,0,0,0" Padding="0,4" Style="{StaticResource Quiet}"
                       ToolTip="Open the destination folder in Explorer"
                       Click="OnOpenFolder" />
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Width="130" Padding="0,7"
                    Margin="0,0,10,0" IsEnabled="False"
                    Style="{StaticResource Quiet}" Click="OnCancel" />
            <Button x:Name="CaptureButton" Content="Capture" Width="130" Padding="0,7"
                    Style="{StaticResource Primary}" Click="OnCapture" />
        </StackPanel>

        <TextBlock Grid.Row="6" x:Name="StatusLine" Margin="0,14,0,0"
                   TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
    </Grid>
</Window>
