<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Satellite.DataBlockSnapshot</RootNamespace>
    <AssemblyName>PLC-Framework.Satellite.DataBlockSnapshot</AssemblyName>
    <!-- Win32 icon resource: what Explorer, Alt-Tab and shortcuts show. It must be a
         file on disk at build time, so it reads assets\ directly rather than through
         the copy Core embeds. Window.Icon is set separately, in XAML. -->
    <ApplicationIcon>..\..\assets\Brand\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\UI.Shared\UI.Shared.csproj" />
    <ProjectReference Include="..\S7PlcWebserverApi\S7PlcWebserverApi.csproj" />
  </ItemGroup>

  <!-- Writing a real .xlsx by hand means five XML parts in a zip whose only true test
       is whether Excel opens it. With the capture's reliability as the priority, that is
       not the place to save a dependency. Microsoft's own SDK, MIT licensed. -->
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

  <!-- WPF has no folder picker of its own. FolderBrowserDialog is the one in the box;
       an SDK-style net48 project does not reference the framework assemblies on its own. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <!-- ProtectedData - DPAPI - for the remembered web server passwords. Same story:
         System.Security is not part of the default net48 reference set. -->
    <Reference Include="System.Security" />
  </ItemGroup>
  
</Project>
