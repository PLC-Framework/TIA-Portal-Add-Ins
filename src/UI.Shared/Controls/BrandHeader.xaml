<UserControl x:Class="UI.Shared.Controls.BrandHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Header">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The URI carries the AssemblyName, not the project name. Merged here as
                     well as in the application, so the control renders in a designer and in
                     a test that hosts it without one. -->
                <ResourceDictionary Source="pack://application:,,,/PLC-Framework.UI.Shared;component/Resources/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PLC-Framework.UI.Shared;component/Resources/BrandLogo.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <Image Source="{StaticResource BrandLogo}" Width="38" Height="38" VerticalAlignment="Center" />

        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title, ElementName=Header}"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource BrandBrushTop}" />

                <!-- Collapsed rather than blank when there is nothing to say: an empty border
                     beside a title reads as something that failed to load. -->
                <Border x:Name="BadgeChrome" Margin="10,2,0,0" Padding="6,1"
                        CornerRadius="3" VerticalAlignment="Center"
                        Background="{StaticResource Field}"
                        BorderBrush="{StaticResource FieldEdge}" BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock Text="{Binding Badge, ElementName=Header}"
                               FontSize="11" Foreground="{StaticResource InkMuted}" />
                </Border>
            </StackPanel>

            <TextBlock x:Name="SubtitleLine"
                       Text="{Binding Subtitle, ElementName=Header}"
                       FontSize="11" Foreground="{StaticResource InkMuted}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </StackPanel>
</UserControl>
