<!--
    The dark-theme control styles, shared by every windowed app in the framework.

    They were written for Satellite.DataBlockSnapshot and lived in its MainWindow.xaml
    until Satellite.ConfigEditor needed the same ~290 lines. Copying them would have made
    the third copy of the palette and the second of the templates, which is how two windows
    that are supposed to look alike start drifting.

    Merging this dictionary is enough: it pulls Theme.xaml in itself, so a consumer cannot
    get the order wrong or forget half of it.

    Almost everything here is an implicit style - no x:Key - so a plain <TextBox/> is
    already themed. Only the choices a window has to make are keyed: Quiet vs Primary for
    a button, FieldLabel for a caption, Reveal for a password eye.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- The URI carries the AssemblyName, not the project name. -->
        <ResourceDictionary Source="pack://application:,,,/PLC-Framework.UI.Shared;component/Resources/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="TextBlock" x:Key="FieldLabel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
    </Style>

    <!--
        The chrome every typed-into field wears.

        A plain Setter cannot reach this: the stock template repaints the border from its
        own hardcoded brushes on hover and on focus - the Windows blue - so those two states
        are the one part of a field that a palette cannot touch without replacing the
        template.

        TargetType is Control rather than TextBox so the identical chrome serves the
        PasswordBox too. Both derive from TextBoxBase, which finds its editing surface by
        the name PART_ContentHost, and every TemplateBinding here is to a property Control
        already declares.
    -->
    <ControlTemplate x:Key="FieldChrome" TargetType="Control">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeHover}" />
            </Trigger>
            <!-- The focused field is marked in the brand colour instead. It is the same
                 brush the selection already uses, so a field being edited reads as one
                 thing rather than two. -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrushTop}" />
            </Trigger>
            <!-- Border and text only, deliberately not the background: this same template
                 lands on the ComboBox's own PART_EditableTextBox, which is transparent by
                 design, and repainting it would put a solid patch inside the drop-down
                 whenever the form is busy. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeDisabled}" />
                <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrandBrushTop}" />
        <Setter Property="Template" Value="{StaticResource FieldChrome}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrandBrushTop}" />
        <Setter Property="Template" Value="{StaticResource FieldChrome}" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushBottom}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An editable ComboBox needs its own template. The stock chrome paints the text area
         and the drop-down button from its own brushes and ignores Background, which is
         exactly what leaves a white box sitting on a dark form. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="27" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Bd" Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />

                        <!-- Declared before the editable TextBox so it sits *under* it:
                             with IsEditable the TextBox takes the clicks over its own area
                             and this still opens the drop-down from anywhere else, while a
                             read-only ComboBox opens from anywhere at all - which is how
                             one behaves everywhere in Windows. -->
                        <ToggleButton x:Name="Toggle" Grid.ColumnSpan="2"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{StaticResource InkMuted}"
                                              HorizontalAlignment="Right" Margin="0,0,7,0"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- What a **non-editable** ComboBox shows. Without this the
                             control renders empty however good the binding is: the stock
                             template has one of these and a template written for the
                             editable case alone quietly loses it. Not hit-testable, so
                             the ToggleButton underneath still gets the click. -->
                        <ContentPresenter x:Name="Selected" Grid.Column="0"
                                          Margin="7,0,0,0"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <!-- Padding zero on purpose. The implicit TextBox style carries 6,4
                             and its template applies that inside the border, which does not
                             fit the fixed height above and clips the text. The row's own
                             margin already spaces it. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Grid.Column="0" Margin="5,0,0,0" Padding="0"
                                 Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{TemplateBinding Foreground}"
                                 SelectionBrush="{StaticResource BrandBrushTop}"
                                 VerticalContentAlignment="Center" />

                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" PopupAnimation="Slide">
                            <Border Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource FieldEdge}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Editable and read-only are two different controls wearing one
                             template: exactly one of the two ways of showing the value is
                             ever visible. -->
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selected" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- The same three states as a plain field, so the row of controls
                             answers to the pointer and the keyboard as one set. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrushTop}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldDisabled}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeDisabled}" />
                            <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A pop-up menu keeps its own light chrome however the window is painted, so it
         needs a template like every other control here. Same three states as a list row. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource FieldEdge}" BorderThickness="1"
                            Padding="0,4">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushBottom}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The list itself, which had no style until a plain `ListBox` appeared in the core
        updater and came out with the stock chrome: a WHITE background behind rows painted
        in `Ink`, which is light grey - so the text was all but unreadable. The same trap the
        `GridView` corner already records one control down: everything here templates its
        rows and had never templated the box around them, because every list so far was a
        `ListView`.

        `ListView` derives from `ListBox` and is untouched by this - an implicit style matches
        the exact type, which is the same rule that forces `ListBoxItem`, `ListViewItem` and
        `TreeViewItem` to be declared separately below.
    -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="2" />
        <!--
            Auto rather than Disabled: a row here is a file path, and the part that tells two
            of them apart is the file name at the end - exactly what clipping removes. Scroll
            rather than hide, and the window is resizable besides.
        -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <!--
        A plain list row. Same story as the tree node below, and it needs its own style
        because an implicit style matches the exact type: `ListViewItem` derives from
        `ListBoxItem` but does not inherit its style.
    -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="2"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushBottom}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <!-- Selected without focus keeps the same colour, rather than the
                             pale system brush the stock template switches to. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushBottom}" />
                            <Setter Property="Foreground" Value="White" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A tree node. The stock template paints selection from the **system** brushes, which
        is where the blue comes from — and, worse, from the *inactive* system brush when the
        tree does not have focus, which renders as a pale box on a dark form and reads as
        "this row is broken" rather than "this row is selected".

        Both states are painted here in the brand colour instead, so a selected node looks
        selected whether or not the tree has focus, and looks like the rest of the framework.
    -->
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="4">
                                        <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z"
                                              Fill="{StaticResource InkMuted}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 5 Z" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Ink}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Border x:Name="Bd" Grid.Row="0" Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>

                        <ItemsPresenter x:Name="Items" Grid.Row="1" Grid.Column="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- A leaf keeps the indent but loses the arrow: without this the
                             tree looks like everything can be opened. -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushBottom}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <!-- Selected while the tree has no focus. The stock template switches
                             to a pale system brush here; keeping the same colour is what
                             stops a selected node looking like a rendering fault. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushBottom}" />
                            <Setter Property="Foreground" Value="White" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource SurfaceHead}" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Scroll bars. Until these existed every list, tree and text box scrolled with the stock
        light-grey Windows bar - a pale strip across a dark form, most visible in the coding
        style report, whose table scrolls both ways.

        A thin track with a rounded thumb and no arrow buttons: the thumb is what gets dragged,
        the wheel does the rest, and two arrows per bar are chrome a dark form does not need.
        Clicking the track still pages, through the two transparent RepeatButtons.
    -->
    <Style x:Key="ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Background="{StaticResource FieldEdge}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldEdgeHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InkMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBar" TargetType="ScrollBar">
        <Border Background="{TemplateBinding Background}">
            <!-- Reversed, so the top of the track is the top of the content. -->
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumb}" Margin="3,2" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBar" TargetType="ScrollBar">
        <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumb}" Margin="2,3" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPage}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBar}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The square where a horizontal and a vertical bar meet is painted by the stock
         ScrollViewer from the system control brush - light grey. Redefining that one key for
         ScrollViewers alone darkens the corner without touching anything else that reads it. -->
    <Style TargetType="ScrollViewer">
        <Style.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource SurfaceColor}" />
        </Style.Resources>
    </Style>

    <!--
        The scroll viewer of a ListView showing a GridView. It has a style of its own, which the
        implicit one above never reaches, and the stock one draws the corner between the two bars
        as a square outlined in a literal White - not a system brush, so no resource can darken
        it. Found by capturing the report window at its minimum size, where both bars show.

        This is the stock template, with that corner painted in the surface colour. The header
        row sits in its own hidden-bar ScrollViewer exactly as in the original: the header
        presenter keeps itself in step with the rows' horizontal offset, and moving it out of
        that arrangement is how headers stop following the columns.
    -->
    <Style x:Key="{x:Static GridView.GridViewScrollViewerStyleKey}" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="{TemplateBinding Padding}">
                            <ScrollViewer DockPanel.Dock="Top" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                                <GridViewHeaderRowPresenter
                                    Margin="2,0,2,0"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                    Columns="{Binding TemplatedParent.View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                    AllowsColumnReorder="{Binding TemplatedParent.View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderContainerStyle="{Binding TemplatedParent.View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderToolTip="{Binding TemplatedParent.View.ColumnHeaderToolTip, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderStringFormat="{Binding TemplatedParent.View.ColumnHeaderStringFormat, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderContextMenu="{Binding TemplatedParent.View.ColumnHeaderContextMenu, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderTemplate="{Binding TemplatedParent.View.ColumnHeaderTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderTemplateSelector="{Binding TemplatedParent.View.ColumnHeaderTemplateSelector, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ScrollViewer>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    KeyboardNavigation.DirectionalNavigation="Local"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </DockPanel>

                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Cursor="Arrow"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />

                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Cursor="Arrow"
                                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />

                        <!-- The corner, in the surface colour rather than the stock white outline. -->
                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Surface}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat, so the stock grey gradient does not reappear in the middle of a dark form. -->
    <Style TargetType="Button" x:Key="Quiet">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldDisabled}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Quiet}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource BrandBrushTop}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBrushBottom}" />
    </Style>

    <!--
        A button that removes something. Identical to Quiet at rest, and **red under the
        pointer** - which is the whole point: it says what the click will do before it
        happens, and it says it the same way wherever a remove button appears.

        The template is spelled out rather than derived from Quiet with BasedOn: the state
        that changes is a trigger *inside* the template, and BasedOn cannot reach into one.
    -->
    <Style TargetType="Button" x:Key="Destructive">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushTop}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrushBottom}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldDisabled}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The eye that reveals a secret - a PLC password, a GitHub token. Drawn rather than
         loaded: it is two paths and an ellipse, and an .ico would have to be embedded,
         resolved and themed, which is a great deal of machinery for sixteen pixels.
         Transparent background so it reads as part of the field it floats over. -->
    <Style TargetType="ToggleButton" x:Key="Reveal">
        <Setter Property="Width" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent">
                        <Canvas Width="16" Height="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="Eye"
                                  Data="M 1,7 C 4,2.5 12,2.5 15,7 C 12,11.5 4,11.5 1,7 Z"
                                  Stroke="{StaticResource InkMuted}" StrokeThickness="1.2" />
                            <Ellipse x:Name="Pupil" Canvas.Left="6" Canvas.Top="5"
                                     Width="4" Height="4" Fill="{StaticResource InkMuted}" />
                            <!-- The strike-through, shown only while the secret is on
                                 screen: the icon states what is true now, not what
                                 clicking would do. -->
                            <Path x:Name="Strike" Data="M 2,12.5 L 14,1.5"
                                  Stroke="{StaticResource InkMuted}" StrokeThickness="1.2"
                                  Visibility="Collapsed" />
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Strike" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Eye" Property="Stroke" Value="{StaticResource Ink}" />
                            <Setter TargetName="Pupil" Property="Fill" Value="{StaticResource Ink}" />
                            <Setter TargetName="Strike" Property="Stroke" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Eye" Property="Stroke" Value="{StaticResource InkDisabled}" />
                            <Setter TargetName="Pupil" Property="Fill" Value="{StaticResource InkDisabled}" />
                            <Setter TargetName="Strike" Property="Stroke" Value="{StaticResource InkDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- No ToolTip here. It used to flip between "Show the password" and "Hide the
             password", which cannot survive a style that also serves a GitHub token: the
             alternative was a text vague enough to fit both, and "Hide" tells nobody
             anything. The window says what its own field holds, and the struck-through eye
             already shows which state it is in. -->
    </Style>

</ResourceDictionary>
