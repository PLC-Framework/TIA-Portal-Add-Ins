<!--
    The dark-theme control styles, shared by every windowed app in the framework.

    They were written for Satellite.DataBlockSnapshot and lived in its MainWindow.xaml
    until Satellite.ConfigEditor needed the same ~290 lines. Copying them would have made
    the third copy of the palette and the second of the templates, which is how two windows
    that are supposed to look alike start drifting.

    Merging this dictionary is enough: it pulls Theme.xaml in itself, so a consumer cannot
    get the order wrong or forget half of it.

    Almost everything here is an implicit style - no x:Key - so a plain <TextBox/> is
    already themed. Only the choices a window has to make are keyed: Quiet vs Primary for
    a button, FieldLabel for a caption, Reveal for a password eye.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- The URI carries the AssemblyName, not the project name. -->
        <ResourceDictionary Source="pack://application:,,,/PLC-Framework.UI.Shared;component/Resources/Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="TextBlock" x:Key="FieldLabel">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
    </Style>

    <!--
        The chrome every typed-into field wears.

        A plain Setter cannot reach this: the stock template repaints the border from its
        own hardcoded brushes on hover and on focus - the Windows blue - so those two states
        are the one part of a field that a palette cannot touch without replacing the
        template.

        TargetType is Control rather than TextBox so the identical chrome serves the
        PasswordBox too. Both derive from TextBoxBase, which finds its editing surface by
        the name PART_ContentHost, and every TemplateBinding here is to a property Control
        already declares.
    -->
    <ControlTemplate x:Key="FieldChrome" TargetType="Control">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeHover}" />
            </Trigger>
            <!-- The focused field is marked in the brand colour instead. It is the same
                 brush the selection already uses, so a field being edited reads as one
                 thing rather than two. -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrushTop}" />
            </Trigger>
            <!-- Border and text only, deliberately not the background: this same template
                 lands on the ComboBox's own PART_EditableTextBox, which is transparent by
                 design, and repainting it would put a solid patch inside the drop-down
                 whenever the form is busy. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeDisabled}" />
                <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrandBrushTop}" />
        <Setter Property="Template" Value="{StaticResource FieldChrome}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource BrandBrushTop}" />
        <Setter Property="Template" Value="{StaticResource FieldChrome}" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushBottom}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An editable ComboBox needs its own template. The stock chrome paints the text area
         and the drop-down button from its own brushes and ignores Background, which is
         exactly what leaves a white box sitting on a dark form. -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="27" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Bd" Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />

                        <!-- Declared before the editable TextBox so it sits *under* it:
                             with IsEditable the TextBox takes the clicks over its own area
                             and this still opens the drop-down from anywhere else, while a
                             read-only ComboBox opens from anywhere at all - which is how
                             one behaves everywhere in Windows. -->
                        <ToggleButton x:Name="Toggle" Grid.ColumnSpan="2"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{StaticResource InkMuted}"
                                              HorizontalAlignment="Right" Margin="0,0,7,0"
                                              VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- What a **non-editable** ComboBox shows. Without this the
                             control renders empty however good the binding is: the stock
                             template has one of these and a template written for the
                             editable case alone quietly loses it. Not hit-testable, so
                             the ToggleButton underneath still gets the click. -->
                        <ContentPresenter x:Name="Selected" Grid.Column="0"
                                          Margin="7,0,0,0"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <!-- Padding zero on purpose. The implicit TextBox style carries 6,4
                             and its template applies that inside the border, which does not
                             fit the fixed height above and clips the text. The row's own
                             margin already spaces it. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Grid.Column="0" Margin="5,0,0,0" Padding="0"
                                 Visibility="Collapsed"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{TemplateBinding Foreground}"
                                 SelectionBrush="{StaticResource BrandBrushTop}"
                                 VerticalContentAlignment="Center" />

                        <Popup x:Name="PART_Popup" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" PopupAnimation="Slide">
                            <Border Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource FieldEdge}" BorderThickness="1"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Editable and read-only are two different controls wearing one
                             template: exactly one of the two ways of showing the value is
                             ever visible. -->
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selected" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- The same three states as a plain field, so the row of controls
                             answers to the pointer and the keyboard as one set. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandBrushTop}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldDisabled}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeDisabled}" />
                            <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A pop-up menu keeps its own light chrome however the window is painted, so it
         needs a template like every other control here. Same three states as a list row. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource FieldEdge}" BorderThickness="1"
                            Padding="0,4">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandBrushBottom}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource SurfaceHead}" />
        <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat, so the stock grey gradient does not reappear in the middle of a dark form. -->
    <Style TargetType="Button" x:Key="Quiet">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Field}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource InkDisabled}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldDisabled}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldEdgeDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Quiet}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource BrandBrushTop}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandBrushBottom}" />
    </Style>

    <!-- The eye that reveals a secret - a PLC password, a GitHub token. Drawn rather than
         loaded: it is two paths and an ellipse, and an .ico would have to be embedded,
         resolved and themed, which is a great deal of machinery for sixteen pixels.
         Transparent background so it reads as part of the field it floats over. -->
    <Style TargetType="ToggleButton" x:Key="Reveal">
        <Setter Property="Width" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent">
                        <Canvas Width="16" Height="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="Eye"
                                  Data="M 1,7 C 4,2.5 12,2.5 15,7 C 12,11.5 4,11.5 1,7 Z"
                                  Stroke="{StaticResource InkMuted}" StrokeThickness="1.2" />
                            <Ellipse x:Name="Pupil" Canvas.Left="6" Canvas.Top="5"
                                     Width="4" Height="4" Fill="{StaticResource InkMuted}" />
                            <!-- The strike-through, shown only while the secret is on
                                 screen: the icon states what is true now, not what
                                 clicking would do. -->
                            <Path x:Name="Strike" Data="M 2,12.5 L 14,1.5"
                                  Stroke="{StaticResource InkMuted}" StrokeThickness="1.2"
                                  Visibility="Collapsed" />
                        </Canvas>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Strike" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Eye" Property="Stroke" Value="{StaticResource Ink}" />
                            <Setter TargetName="Pupil" Property="Fill" Value="{StaticResource Ink}" />
                            <Setter TargetName="Strike" Property="Stroke" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Eye" Property="Stroke" Value="{StaticResource InkDisabled}" />
                            <Setter TargetName="Pupil" Property="Fill" Value="{StaticResource InkDisabled}" />
                            <Setter TargetName="Strike" Property="Stroke" Value="{StaticResource InkDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- No ToolTip here. It used to flip between "Show the password" and "Hide the
             password", which cannot survive a style that also serves a GitHub token: the
             alternative was a text vague enough to fit both, and "Hide" tells nobody
             anything. The window says what its own field holds, and the struck-through eye
             already shows which state it is in. -->
    </Style>

</ResourceDictionary>
