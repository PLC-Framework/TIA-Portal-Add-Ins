<!--
    Brand palette, shared by every executable with a window.

    The two colours are the ones the logo is actually drawn with — they were read back
    from a render of BrandLogo.xaml, not picked by eye — so the UI and the mark cannot
    drift apart.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BrandColorTop">#E22D50</Color>
    <Color x:Key="BrandColorBottom">#B11A39</Color>
    <Color x:Key="DarkThemeColorTop">#4D576C</Color>
    <Color x:Key="DarkThemeColorBottom">#1E232A</Color>
    
    <SolidColorBrush x:Key="BrandBrushTop" Color="{StaticResource BrandColorTop}" />
    <SolidColorBrush x:Key="BrandBrushBottom" Color="{StaticResource BrandColorBottom}" />

    <SolidColorBrush x:Key="DarkThemeBrushTop" Color="{StaticResource DarkThemeColorTop}" />
    <SolidColorBrush x:Key="DarkThemeBrushBottom" Color="{StaticResource DarkThemeColorBottom}" />

    <!--
        Window background. Vertical on purpose: StartPoint and EndPoint are relative to the
        bounding box by default, so 0,0 to 0,1 is top to bottom whatever the window's size.

        Lighter at the top, which is where the logo sits, so the mark keeps its contrast
        while the text below settles onto the darker end.
    -->
    <LinearGradientBrush x:Key="DarkThemeGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource DarkThemeColorTop}" />
        <GradientStop Offset="1" Color="{StaticResource DarkThemeColorBottom}" />
    </LinearGradientBrush>

    <!--
        Surfaces and ink for a form sitting on that gradient.

        One surface for everything the operator types into, a shade lighter than the ground
        so a field reads as inset rather than as a hole punched in the form.

        Every one of these has a name because every one of them is used in more than one
        place. They were literals inside triggers until the styles moved here, which is how
        a "disabled grey" ends up being three slightly different greys.
    -->
    <SolidColorBrush x:Key="Field"          Color="#333B47" />
    <SolidColorBrush x:Key="FieldEdge"      Color="#5A6473" />
    <SolidColorBrush x:Key="FieldEdgeHover" Color="#7A8494" />
    <SolidColorBrush x:Key="FieldHover"     Color="#3E4756" />
    <SolidColorBrush x:Key="Surface"        Color="#2A313B" />
    <SolidColorBrush x:Key="SurfaceHead"    Color="#3A4350" />
    <SolidColorBrush x:Key="Ink"            Color="#E8ECF2" />
    <SolidColorBrush x:Key="InkMuted"       Color="#98A3B2" />

    <!-- Rows in a list: hover and selection, both a step up from the surface they sit on. -->
    <SolidColorBrush x:Key="RowHover"       Color="#39424F" />
    <SolidColorBrush x:Key="RowSelected"    Color="#3F4A5A" />

    <!-- Disabled. Dimmer than the enabled set rather than greyer, so a disabled form still
         reads as the same form. -->
    <SolidColorBrush x:Key="FieldDisabled"     Color="#2B323C" />
    <SolidColorBrush x:Key="FieldEdgeDisabled" Color="#454E5B" />
    <SolidColorBrush x:Key="InkDisabled"       Color="#6C7686" />

</ResourceDictionary>
