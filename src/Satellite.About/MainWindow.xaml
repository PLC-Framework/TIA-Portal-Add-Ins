<Window x:Class="Satellite.About.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Core;assembly=PLC-Framework.Core"
        Title="{x:Static core:Product.Title}"
        Icon="{StaticResource BrandLogo}"
        Height="530" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkThemeGradientBrush}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="28,44,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The logo is a DrawingImage, so it stays vector at any size. Only Width is set:
             Stretch is Uniform by default, so the height follows the drawing's own aspect
             and the mark cannot be squashed by a wrong guess. -->
        <Image Grid.Row="0"
               Source="{StaticResource BrandLogo}"
               Width="300"
               HorizontalAlignment="Left" Margin="23,0,0,0" />

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,0">
            <TextBlock Text="{x:Static core:Product.Title}"
                       Foreground="{StaticResource BrandBrushTop}"
                       FontSize="32"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <!-- The number a tester reads back when something goes wrong. This window is
                 the only place it is on screen, which is why the About entry earns its
                 place in the menu at all. -->
            <TextBlock Text="{x:Static core:Product.Version}"
                       Foreground="{StaticResource InkMuted}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="A very Platypus-like framework for designing modern PLC programs!"
                   Foreground="#FFFFFFFF"
                   FontSize="14"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   LineHeight="22"
                   HorizontalAlignment="Center"
                   Margin="16,10,16,0" />
    </Grid>

</Window>
