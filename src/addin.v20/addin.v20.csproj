<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Main properties -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>addin</RootNamespace>
    <AssemblyName>PLC-Framework.v20</AssemblyName>
  </PropertyGroup>

  <!-- Siemens properties -->
  <PropertyGroup>
    <SiemensPublicApi Condition="'$(SiemensPublicApi)' == ''">$(MSBuildThisFileDirectory)..\..\..\.lib\Siemens\PublicAPI</SiemensPublicApi>
    <TiaAddInApi>$(SiemensPublicApi)\V20.addIn</TiaAddInApi>
    <!-- App used to compile and generate .addin file -->
    <TiaPublisher>$(TiaAddInApi)\Siemens.Engineering.AddIn.Publisher.exe</TiaPublisher>
  </PropertyGroup>

  <!-- External references -->
  <ItemGroup>
    <Reference Include="Siemens.Engineering.AddIn">
      <HintPath>$(TiaAddInApi)\Siemens.Engineering.AddIn.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.AddIn.Permissions">
      <HintPath>$(TiaAddInApi)\Siemens.Engineering.AddIn.Permissions.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.AddIn.Utilities">
      <HintPath>$(TiaAddInApi)\Siemens.Engineering.AddIn.Utilities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Hmi">
      <HintPath>$(TiaAddInApi)\Siemens.Engineering.Hmi.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Packages the built DLL into a .addin file TIA Portal can load, using the
      Siemens-provided publisher tool and Config.xml. The Publisher
      resolves the config's <Assembly> path relative to the config file itself, so
      a copy with an absolute path is generated in obj/ instead of copying the
      template into bin/. -->
  <Target Name="PublishTiaAddIn" AfterTargets="Build" Condition="Exists('$(TiaPublisher)')">
    
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Config.xml" DestinationFolder="$(TargetDir)" />
    <Exec Command="&quot;$(TiaPublisher)&quot; --configuration &quot;$(TargetDir)Config.xml&quot; --outfile &quot;$(TargetDir)$(TargetName).addin&quot; --console" />
  </Target>

  <Target Name="WarnIfPublisherMissing" AfterTargets="Build" Condition="!Exists('$(TiaPublisher)')">
    <Warning Text="Publisher was not found in '$(TiaPublisher)'. File .dll was compiled, but file .addin was not generated." />
  </Target>

</Project>