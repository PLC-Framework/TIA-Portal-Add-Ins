<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- What every satellite that talks to TIA Portal from outside it shares, and none of it
       touches Siemens: the session's port, the thread Openness objects have to live on, what
       an attach is and how the right instance is recognised, and finding TIA's assemblies on
       the machine. The half that does touch Siemens is Openness.V20 and Openness.V21, compiled
       once per version because the two are different assemblies with different public key
       tokens - the same split as AddIn.Shared and the two Add-Ins.

       AnyCPU, like AddIn.Shared: it loads nothing of TIA's itself. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Openness.Shared</RootNamespace>
    <AssemblyName>PLC-Framework.Openness.Shared</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <!-- WMI, to read the chain of processes this one descends from - one of the signals that
       say which TIA Portal to attach to. Not part of the default net48 reference set. -->
  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>

</Project>
