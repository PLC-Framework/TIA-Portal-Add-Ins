<Window x:Class="Satellite.CodingStyleReport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UI.Shared.Controls;assembly=PLC-Framework.UI.Shared"
        Title="Coding style report"
        Icon="{StaticResource BrandLogo}"
        Height="680" Width="1240"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkThemeGradientBrush}"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnWindowKey">

    <Window.Resources>
        <!-- An outcome filter: on shows those rows, off hides them. A chip rather than a tick
             box, carrying the outcome's colour and its count, so the bar doubles as the summary
             of what the check found. Kept in this window while nothing else needs one. -->
        <Style x:Key="OutcomeChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldEdge}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldHover}" />
                            </Trigger>
                            <!-- Off: dimmed, and the edge gives way, so what is hidden reads as hidden. -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A cell that shows one line and hands the whole of it to a tooltip. -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The subtitle says which project, what was selected and when. Several of these
                 windows can be open at once, one per run, so each has to say which run it is. -->
            <ui:BrandHeader x:Name="Header" Grid.Column="0" Title="Coding style report" />

            <!-- Only when TIA Portal sent nothing: a window opened from the menu is that run's
                 report, and another workbook over it would contradict its own header. -->
            <Button Grid.Column="1" x:Name="ImportButton" Content="Import .xlsx..." Width="130" Padding="0,6"
                    VerticalAlignment="Center" Style="{StaticResource Quiet}"
                    ToolTip="Open a coding-style report exported earlier"
                    Click="OnImport" />
        </Grid>

        <TextBlock Grid.Row="1" x:Name="SummaryLine" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{StaticResource Ink}" />

        <!-- Filters. The chips wrap onto a second line in a narrow window; the kind and the
             search keep their width, because a search box that shrinks to nothing is gone. -->
        <Grid Grid.Row="2" x:Name="FilterBar" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- Failed first: it is what the report is opened for. -->
                <ToggleButton x:Name="FailedChip" Style="{StaticResource OutcomeChip}" IsChecked="True"
                              ToolTip="Names that matched none of the rules offered to them"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource InkBad}" VerticalAlignment="Center" />
                        <TextBlock x:Name="FailedCount" Margin="7,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="NotConfiguredChip" Style="{StaticResource OutcomeChip}" IsChecked="True"
                              ToolTip="Objects of a type no rule is configured for"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource InkWarn}" VerticalAlignment="Center" />
                        <TextBlock x:Name="NotConfiguredCount" Margin="7,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="SkippedChip" Style="{StaticResource OutcomeChip}" IsChecked="True"
                              ToolTip="Not checked, with the reason in the Note column"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource InkWarn}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SkippedCount" Margin="7,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="PassedChip" Style="{StaticResource OutcomeChip}" IsChecked="True"
                              ToolTip="Names that matched a rule"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource InkGood}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PassedCount" Margin="7,0,0,0" />
                    </StackPanel>
                </ToggleButton>
            </WrapPanel>

            <ComboBox Grid.Column="1" x:Name="KindBox" Width="160" Margin="8,0,0,0" VerticalAlignment="Top"
                      ToolTip="Show one kind of object or interface section"
                      SelectionChanged="OnFilterChanged" Height="35" />

            <!-- A watermark rather than a label: the box explains itself until it is used. -->
            <Grid Grid.Column="2" Width="220" Margin="8,0,0,6" VerticalAlignment="Top">
                <TextBox x:Name="SearchBox" TextChanged="OnFilterChanged" KeyDown="OnSearchKey"
                         ToolTip="Searches every column - PLC, unit, object, name, path, rules and notes. Ctrl+F to get here, Esc to clear." />
                <TextBlock Text="Search" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Foreground="{StaticResource InkDisabled}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource FieldEdge}" BorderThickness="1"
                Background="{StaticResource Surface}">
            <Grid>
                <ListView x:Name="RowList" BorderThickness="0" Background="Transparent"
                          Foreground="{StaticResource Ink}"
                          VirtualizingPanel.IsVirtualizing="True">
                    <!-- The outcome colours the whole row. Red for a name that matched no rule -
                         what the report is for - and amber for what could not be judged, which
                         is a different problem and must not be mistaken for a failure. -->
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OutcomeName}" Value="Failed">
                                    <Setter Property="Foreground" Value="{StaticResource InkBad}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OutcomeName}" Value="NotConfigured">
                                    <Setter Property="Foreground" Value="{StaticResource InkWarn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OutcomeName}" Value="Skipped">
                                    <Setter Property="Foreground" Value="{StaticResource InkWarn}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Result" Width="90" DisplayMemberBinding="{Binding Result}" />
                            <!-- A project holds several PLCs and a PLC several units, each with the
                                 same folders and often the same names, so where a row comes from is
                                 three answers. The unit column shows * for the general program. -->
                            <GridViewColumn Header="PLC" Width="90" DisplayMemberBinding="{Binding Plc}" />
                            <GridViewColumn Header="Software unit" Width="100" DisplayMemberBinding="{Binding Unit}" />
                            <!-- Which object a member belongs to. The row above says it too, until
                                 the table is sorted or a filter hides that row. -->
                            <GridViewColumn Header="Object" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Owner}" Style="{StaticResource Cell}" ToolTip="{Binding OwnerTip}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Kind" Width="100" DisplayMemberBinding="{Binding Kind}" />
                            <!-- Where a member sits inside the interface. The name beside it is
                                 what a rule was held against; joining the two would produce a
                                 string no naming rule could ever read. -->
                            <GridViewColumn Header="Parent" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Parent}" Style="{StaticResource Cell}" ToolTip="{Binding ParentTip}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Name" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" ToolTip="{Binding NameTip}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Path" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource Cell}" ToolTip="{Binding PathTip}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- The rule's pattern and description on hover: what the id means is
                                 the first question a failing row raises. -->
                            <GridViewColumn Header="Rules" Width="170">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Rules}" Style="{StaticResource Cell}" ToolTip="{Binding RulesTip}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Note" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Cell}" ToolTip="{Binding NoteTip}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- No report: started by hand, or what arrived could not be read. -->
                <TextBlock x:Name="EmptyNote" Visibility="Collapsed" Margin="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                           Foreground="{StaticResource InkMuted}" />

                <!-- TIA Portal is still checking. The window opens here rather than when the
                     report is ready: a project-wide check takes minutes, and nothing on screen
                     reads as an Add-In that died. -->
                <StackPanel x:Name="WaitingPanel" Visibility="Collapsed" Margin="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock x:Name="WaitingLine" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource Ink}" />
                    <TextBlock Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource InkMuted}"
                               Text="The report appears here when TIA Portal finishes. TIA is busy while it works, and a whole PLC takes a while." />

                    <!-- Movement rather than a percentage: the check knows how many objects it
                         has, not how long each will take, and a bar that guesses is worse than
                         one that only says work is happening. -->
                    <Border Width="320" Height="4" Margin="0,20,0,0" CornerRadius="2"
                            Background="{StaticResource Field}" ClipToBounds="True">
                        <Border x:Name="WaitingPulse" Width="96" Height="4" CornerRadius="2"
                                HorizontalAlignment="Left" Background="{StaticResource BrandBrushTop}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="WaitingSlide" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Export. The folder defaults to the project's .plc-framework\reports and stays
             editable; the file name is the window's to choose, so it never overwrites. -->
        <Grid Grid.Row="4" x:Name="ExportBar" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Folder" Style="{StaticResource FieldLabel}" />
            <TextBox   Grid.Column="1" x:Name="FolderBox" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BrowseButton" Content="..." Width="34" Margin="8,0,0,0" Padding="0,4"
                        Style="{StaticResource Quiet}" ToolTip="Choose where the workbook is written"
                        Click="OnBrowseFolder" />
                <Button x:Name="OpenFolderButton" Content="Open" Width="70" Margin="8,0,0,0" Padding="0,4"
                        Style="{StaticResource Quiet}" ToolTip="Open the folder in Explorer"
                        Click="OnOpenFolder" />
                <!-- Every row, whatever the filters show: a workbook of the failures alone would
                     read as a clean report to whoever opens it next. -->
                <Button x:Name="ExportButton" Content="Export .xlsx" Width="130" Margin="16,0,0,0" Padding="0,6"
                        Style="{StaticResource Primary}"
                        ToolTip="Write every row of the report, whatever the filters show, with its rules and provenance"
                        Click="OnExport" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" x:Name="StatusLine" Margin="0,12,0,0"
                   TextWrapping="Wrap" Foreground="{StaticResource Ink}" />
    </Grid>
</Window>
