<Window x:Class="Satellite.ImportObjects.Overwrite.OverwriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UI.Shared.Controls;assembly=PLC-Framework.UI.Shared"
        Title="Overwrite?"
        Height="440" Width="880"
        MinHeight="300" MinWidth="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Merged here because this project has no App.xaml - see MainWindow.xaml. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PLC-Framework.UI.Shared;component/Resources/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PLC-Framework.UI.Shared;component/Resources/BrandLogo.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Background>
        <StaticResource ResourceKey="DarkThemeGradientBrush" />
    </Window.Background>
    <Window.Icon>
        <StaticResource ResourceKey="BrandLogo" />
    </Window.Icon>

    <!-- No BrandHeader: a question the import asks, not a satellite of its own - the core
         updater's download window is the same shape for the same reason. The status bar stays,
         because it has something to say: what the ticks add up to. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="These files would overwrite what the PLC already has"
                   FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />

        <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="{StaticResource InkMuted}"
                   Text="TIA Portal overwrites an object that is already there without asking, so this is the question. A ticked file overwrites what it meets where that is, which may not be the folder you right-clicked; an unticked one is left out and changes nothing. A file is taken whole: a source declaring several objects cannot be taken in part." />

        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource FieldEdge}" BorderThickness="1" Padding="4">
            <ListView x:Name="Rows">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="34">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Take, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="File" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FileName}" Foreground="{Binding Ink}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Already in the PLC" Width="380">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Held}" Foreground="{Binding Ink}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Held}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Would" Width="170">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Outcome}" Foreground="{Binding OutcomeInk}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Outcome}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="YesToAllButton" Content="Yes to all" Style="{StaticResource Quiet}" MinWidth="96"
                        Click="YesToAllClicked" />
                <Button x:Name="NoToAllButton" Content="No to all" Style="{StaticResource Quiet}" MinWidth="96"
                        Margin="6,0,0,0" Click="NoToAllClicked" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Quiet}" MinWidth="96"
                        IsCancel="True" Click="CancelClicked" />
                <Button x:Name="GoButton" Content="Import" Style="{StaticResource Primary}"
                        MinWidth="110" Margin="8,0,0,0" IsDefault="True" Click="GoClicked" />
            </StackPanel>
        </Grid>

        <ui:StatusBar x:Name="StatusText" Grid.Row="4" Margin="0,14,0,0" />
    </Grid>
</Window>
