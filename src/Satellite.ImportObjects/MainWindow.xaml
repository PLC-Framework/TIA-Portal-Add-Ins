<Window x:Class="Satellite.ImportObjects.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UI.Shared.Controls;assembly=PLC-Framework.UI.Shared"
        Title="Import objects"
        Height="220" Width="460"
        MinHeight="180" MinWidth="360"
        WindowStartupLocation="Manual">

    <!-- Merged on the window rather than on an application, for the core updater's reason: no
         App.xaml is what lets one library serve the V20 and V21 executables, and it is also what
         lets the XAML designer resolve these. The URI carries the assembly name, and
         Controls.xaml pulls Theme.xaml in itself. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PLC-Framework.UI.Shared;component/Resources/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/PLC-Framework.UI.Shared;component/Resources/BrandLogo.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Property elements below Window.Resources, not attributes on the start tag: an attribute
         is set before the parser reaches the dictionary declared underneath. -->
    <Window.Background>
        <StaticResource ResourceKey="DarkThemeGradientBrush" />
    </Window.Background>
    <Window.Icon>
        <StaticResource ResourceKey="BrandLogo" />
    </Window.Icon>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The badge carries V20 or V21: one binary per TIA version, otherwise identical. -->
        <ui:BrandHeader x:Name="Header" Grid.Row="0" Title="Import objects" />

        <Grid Grid.Row="1" Margin="0,18,0,0">

            <!-- The window opens at this panel's size, in a corner: TIA Portal asks the engineer
                 to confirm the access while this is attaching, and a large window covers the box
                 it asks in. See Grow in the code-behind. -->
            <StackPanel x:Name="WaitingPanel" VerticalAlignment="Center">
                <TextBlock x:Name="WaitingText"
                           Text="Looking for the TIA Portal that opened this…"
                           FontSize="14" Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Height="4" Width="260" Margin="0,14,0,0" />
            </StackPanel>

            <Grid x:Name="AttachedPanel" Visibility="Collapsed" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Where it goes: the folder that was right-clicked, which this window cannot
                     change - the menu entry is the choice. -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Into" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="DestinationText" Grid.Column="1" FontSize="14"
                               Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Where it comes from: a Windows folder, and then the files in it. -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="From" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="FolderBox" Grid.Column="1" KeyDown="FolderKeyDown" />
                    <Button x:Name="BrowseButton" Grid.Column="2" Content="..." Width="40"
                            Style="{StaticResource Quiet}" Margin="6,0,0,0" Click="BrowseClicked" />
                </Grid>

                <!-- The files of that folder in the order they would go in: types, then tag
                     tables, then FCs and FBs, then data blocks, then OBs. -->
                <Border Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource FieldEdge}" BorderThickness="1" Padding="4">
                    <ListView x:Name="FilesList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Take, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="File" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileName}" Foreground="{Binding Ink}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Format" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Format}" Foreground="{Binding Muted}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Format}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Declares" Width="240">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Declares}" Foreground="{Binding DeclaresInk}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Declares}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Result" Width="310">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ResultWords}" Foreground="{Binding ResultInk}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultWords}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <!-- What is not offered, and why the folder cannot be imported into. -->
                <TextBlock x:Name="ProblemsText" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource InkWarn}" Visibility="Collapsed" />

                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="AllButton" Content="All" Style="{StaticResource Quiet}" MinWidth="64"
                                Click="AllClicked" />
                        <Button x:Name="NoneButton" Content="None" Style="{StaticResource Quiet}" MinWidth="64"
                                Margin="6,0,0,0" Click="NoneClicked" />
                    </StackPanel>

                    <!-- Stop acts between two files: one already on its way into TIA is not
                         taken back, there being no transaction to take it back with. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="StopButton" Content="Stop" Style="{StaticResource Quiet}" MinWidth="96"
                                Visibility="Collapsed" Click="StopClicked" />
                        <Button x:Name="ImportButton" Content="Import" Style="{StaticResource Primary}"
                                MinWidth="110" Margin="8,0,0,0" IsEnabled="False" Click="ImportClicked" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Scrolled, because the failure that matters most is the longest: when the Openness
                 assemblies cannot be found, this carries every registry key read and every
                 folder probed. -->
            <ScrollViewer x:Name="ProblemPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="ProblemText" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource InkBad}" />
                    <TextBlock x:Name="ConsideredText" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource InkMuted}" />

                    <!-- Nothing preselected: a highlighted row invites the click this list exists
                         to stop being automatic. -->
                    <ListBox x:Name="ChoicesList" Visibility="Collapsed"
                             Margin="0,12,0,0" MaxHeight="150"
                             SelectionChanged="ChoiceChanged" />
                    <Button x:Name="AttachButton" Content="Attach" Visibility="Collapsed"
                            Style="{StaticResource Primary}" IsEnabled="False"
                            HorizontalAlignment="Left" Margin="0,12,0,0"
                            Click="AttachClicked" />
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <ui:StatusBar x:Name="StatusText" Grid.Row="2" Margin="0,14,0,0" />
    </Grid>
</Window>
